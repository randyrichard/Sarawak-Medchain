/*
 * The public SafeOps demo on Cloudflare Workers: static files only, no server.
 * Built by `npm run build:demo` (scripts/build-demo.mjs); setup in docs/CLOUDFLARE.md,
 * "The public demo". Real deployments do not use this file - they run the Docker stack.
 */
{
  "name": "safeops-demo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
