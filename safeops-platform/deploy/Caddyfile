# SafeChain reverse proxy — Caddy.
#
# Recommended over the nginx config beside this file unless you already run nginx. Caddy
# obtains and renews certificates automatically, redirects HTTP to HTTPS by default, and
# sets sane TLS defaults — three things that are easy to get subtly wrong by hand.
#
# Run it as part of the stack (it reads the same .env.prod as everything else):
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod --profile tls up -d
#
# or standalone, with the three variables exported:
#
#   caddy validate --config deploy/Caddyfile
#   caddy run --config deploy/Caddyfile
#
# ── What the operator must supply ────────────────────────────────────────────
# Nothing here is hard-coded, because a hostname baked into a config file is a hostname
# somebody ships to production by accident. All three come from the environment and Caddy
# refuses to start if any is empty:
#
#   SAFEOPS_APP_DOMAIN   the address people type,   e.g. app.yourcompany.com
#   SAFEOPS_API_DOMAIN   the address the app calls, e.g. api.yourcompany.com
#   ACME_EMAIL           where Let's Encrypt sends expiry warnings
#
# The two hostnames MUST share a registrable domain. The refresh cookie is
# SameSite=Strict, so app.yourcompany.com and api.yourcompany.com work; a pair on
# different registrable domains will silently fail to keep anyone signed in.
#
# Both names must already resolve to this server before you start: Caddy proves control of
# them over HTTP/TLS to get a certificate, so DNS comes first, not after.

{
	# Where Let's Encrypt sends expiry warnings. Required — no default on purpose.
	email {$ACME_EMAIL}
}

# ── Web app ──────────────────────────────────────────────────────────────────
{$SAFEOPS_APP_DOMAIN} {
	encode zstd gzip

	# HSTS. Caddy already redirects HTTP→HTTPS; this stops the first request of a later
	# visit going out in the clear at all. Do not add preload until you are certain every
	# subdomain is HTTPS — it is difficult to undo.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy {$WEB_UPSTREAM:web:8080} {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}

# ── API ──────────────────────────────────────────────────────────────────────
{$SAFEOPS_API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		-Server
	}

	# CORS is the API's own decision — it holds the allow-list and must be the one to
	# refuse an unknown origin. Adding CORS headers here would either duplicate them or
	# override a deliberate refusal, so nothing is set.

	reverse_proxy {$API_UPSTREAM:api:4000} {
		# The API sets `trust proxy`, so this is what makes req.ip the real client rather
		# than this proxy. Per-IP rate limiting depends on it: without these headers every
		# user shares one bucket.
		#
		# Note this SETS X-Forwarded-For rather than appending to it, so a value a client
		# invented is overwritten here with the address the connection actually came from.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}

		# Proves to the API that this request came through this proxy.
		#
		# The overwrite above protects everything that arrives via Caddy. It does nothing
		# for a request that reaches the API without passing through here, and behind Docker
		# such a request is indistinguishable by address: published ports are source-NATed to
		# the bridge gateway, a private address the API's trust list accepts. Measured -
		# forged X-Forwarded-For headers produced separate rate-limit buckets on a direct
		# connection even after the trust list was in place.
		#
		# So the API strips X-Forwarded-For from anything not carrying this token. Must match
		# PROXY_TOKEN in .env.prod; generate with `openssl rand -hex 32`.
		header_up X-SafeOps-Proxy {$PROXY_TOKEN}

		# Health checks decide whether traffic is sent here at all, so they use the
		# readiness endpoint, which reports on the database rather than just the process.
		health_uri /health/ready
		health_interval 10s
		health_timeout 5s

		# Uploads are capped at 10 MB per file, five files per request.
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}

	request_body {
		max_size 60MB
	}
}
