// SafeChain API — authentication & authorization data model.
// Security notes:
//  - `passwordHash` stores an Argon2id digest. Plaintext passwords are never persisted or logged.
//  - Refresh tokens are stored as SHA-256 hashes, never in cleartext, so a database leak does not
//    hand an attacker usable sessions.
//  - Lockout state lives here (server-side) so it cannot be cleared by the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ceo
  admin
  hse_manager
  safety_officer
  supervisor
  employee
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  title        String?
  /// Argon2id digest — never a plaintext or reversible value.
  passwordHash String
  status       String  @default("active") // active | invited | deactivated | locked

  // ── Brute-force protection (server-authoritative) ──
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  /// When the password was last set. Password expiry in the security policy counts from
  /// here. Existing rows took the time of the migration, so nobody expired on upgrade.
  passwordChangedAt DateTime  @default(now())
  lastLoginAt       DateTime?

  mustChangePassword Boolean @default(false)

  /// SafeChain staff, not a member of any customer.
  ///
  /// Deliberately a column rather than a Role value: Role lives on Membership and describes
  /// somebody's place *inside* one company, and a platform administrator has no place
  /// inside any of them. Keeping it separate is also what stops a customer administrator
  /// granting it - the organisation console writes Membership.role and never touches this.
  platformAdmin    Boolean  @default(false)
  /// True only once the person has proved, with a code, that their authenticator works.
  /// Sign-in then asks for a code after the password (mfaService.ts).
  mfaEnabled       Boolean  @default(false)
  /// The authenticator (TOTP) secret, sealed under MFA_SECRET_KEY_B64. Never a plaintext.
  mfaSecret        String?
  /// A secret issued by "set up" and not yet confirmed with a code. Replaced on every new
  /// setup attempt and cleared on confirmation, so an abandoned setup never takes effect.
  mfaPendingSecret String?
  /// SHA-256 digests of the unused one-time recovery codes. A code is removed when used.
  mfaRecoveryCodes String[] @default([])
  /// The last 30-second step a code was accepted for, so a code that has been used once -
  /// read over a shoulder, or replayed from a phishing page - cannot be used again.
  mfaLastStep      Int?
  /// Shown in the admin console's user list. Additive and nullable — authentication
  /// does not read it, so every existing account is unaffected.
  department       String?

  /// Per-user settings that should follow the person between devices:
  /// { landingPage?: string, defaultSiteId?: string | null }.
  ///
  /// Stored as JSON rather than columns because these are read and written whole, by one
  /// screen, and a new preference should not need a migration. Theme is deliberately NOT
  /// here — it belongs to the device, and round-tripping it through the server would make
  /// a dark-mode toggle wait on the network. Nullable, so every existing account keeps
  /// the defaults without a backfill.
  preferences Json?

  memberships        Membership[]
  employee           Employee?
  managedDepartments Department[]         @relation("DepartmentManager")
  managedProjects    Project[]            @relation("ProjectManager")
  managedSites       Site[]               @relation("SiteManager")
  hseLedSites        Site[]               @relation("SiteHseLead")
  invitations        Invitation[]
  refreshTokens      RefreshToken[]
  loginAttempts      LoginAttempt[]
  resetTokens        PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// A user's role within a company. Authorization is derived from these rows on the
/// server — never from anything the client sends.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role
  siteIds   String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
}

/// A single-use password reset issued by an administrator.
///
/// Only the SHA-256 digest is stored, the same rule the refresh tokens follow: the raw
/// value exists once, in the link handed to the user, and a database dump yields nothing
/// an attacker can redeem. `usedAt` makes redemption single-use, and short expiry bounds
/// how long a link left in a chat thread stays dangerous.
model PasswordResetToken {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  /// Who issued it — a reset is an account takeover if misused, so it is attributable.
  issuedBy  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

/// One row per issued refresh token. Rotation replaces the row and links the successor,
/// so replaying a consumed token is detectable (see `revokedReason = "reuse_detected"`).
model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  /// SHA-256 of the opaque token. The raw value exists only in the client's cookie.
  tokenHash String @unique
  /// Groups every token rotated from one login, so a whole session can be revoked at once.
  familyId  String

  expiresAt     DateTime
  /// The latest moment this session may last until, however often it is refreshed: sign-in
  /// plus the security policy's session timeout. Carried to every rotated successor. Null on
  /// sessions started before the timeout was enforced, which keep their old lifetime.
  sessionEndsAt DateTime?
  revokedAt     DateTime?
  revokedReason String?
  replacedById  String?

  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

/// Immutable security event log for authentication. Append-only by convention in Phase 1;
/// hash-chained for tamper evidence in Phase 3.
model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  outcome   String // success | bad_password | unknown_user | locked_out | deactivated
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
}

// ─── Organisation ────────────────────────────────────────────────────────────
// Incidents are scoped by company and site, and RBAC narrows visibility by site,
// so both must be real rows with foreign keys rather than client-side constants.

model Company {
  id   String @id
  name String
  /// Commercial tier. Free-text rather than an enum so existing rows keep the value they
  /// were created with; the recognised keys and their prices live in planCatalog.ts, which
  /// is the only place a price is written down.
  plan String @default("enterprise")

  /// Whether the customer may use the product at all. Separate from subscriptionStatus:
  /// a company can be past due and still working, or paid up and suspended for cause.
  status             String                 @default("active")
  /// trial | active | past_due | cancelled. Recorded here so a billing integration added
  /// later has somewhere to write without reshaping the tenant model.
  subscriptionStatus String                 @default("trial")
  /// Whatever the eventual payment provider calls this customer. Null until one exists.
  billingReference   String?
  /// Set when the company was created through the provisioning console rather than by hand.
  provisionedAt      DateTime?
  provisionedBy      String?
  /// Shown in the company switcher. Additive: every existing row keeps a sensible
  /// default and nothing that reads Company today is affected.
  industry           String                 @default("")
  logoInitials       String                 @default("")
  sites              Site[]
  projects           Project[]
  incidents          Incident[]
  actions            CorrectiveAction[]
  permits            Permit[]
  assets             Asset[]
  inspections        Inspection[]
  audits             Audit[]
  auditTemplates     AuditTemplate[]
  obligations        ComplianceObligation[]
  documents          ComplianceDocument[]
  employees          Employee[]
  ppeIssues          PpeIssue[]
  contractors        ContractorCompany[]
  contractorWorkers  ContractorWorker[]
  courses            TrainingCourse[]
  sessions           TrainingSession[]
  certificates       Certificate[]
  roleDefs           RoleDefinition[]
  adminAudit         AdminAuditEntry[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]
  connectors         ConnectorConfig[]
  securityPolicy     SecurityPolicy?
  orgSettings        OrgSettings?
  invitations        Invitation[]
  configItems        OrgConfigItem[]
  retention          RetentionPolicy?
  backups            Backup[]
  notifications      Notification[]
  createdAt          DateTime               @default(now())
  visitors           Visitor[]
  visitorBlacklist   VisitorBlacklist[]
  toolboxMeetings    ToolboxMeeting[]
  reportSchedules    ReportSchedule[]
  reportRuns         ReportRun[]
  fieldEvidence      FieldEvidence[]

  // Created by an earlier migration and missing here, so `prisma migrate dev` would have
  // generated a migration dropping it. Declared so the schema describes the database.
  @@index([provisionedAt])
}

/// Where a project stands commercially. Not a safety state - a suspended project's
/// incidents stay exactly as readable as an active one's.
enum ProjectStatus {
  planned
  active
  completed
  suspended
  cancelled
}

/// A body of work a company runs, holding one or more sites.
///
/// Added because a contractor's safety picture is organised by the job, not by the yard:
/// an HSE manager reports on "Construction Project A" and expects its sites underneath.
/// Sites existed before projects did, so the link is optional in that direction - a
/// workspace that has never created a project keeps every site, and every record hanging
/// off one, exactly as it was.
///
/// Deliberately NOT denormalised onto incidents, permits, actions and the ten other
/// tables that carry siteId. A record's project is its site's project, resolved by join.
/// A copied projectId would be a second answer to the same question, and the two would
/// disagree the first time a site was moved.
model Project {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  /// The company's own reference, e.g. "PRJ-2026-014". Unique per tenant when set, so two
  /// projects cannot quietly share a code that people use to tell them apart.
  ///
  /// Nullable rather than defaulting to "", because the unique index below is what
  /// enforces that. Postgres treats '' as a value, so a blank default made the second
  /// uncoded project collide with the first; NULLs do not collide, which is the semantics
  /// actually wanted - any number of projects may have no code.
  code String?

  client      String @default("")
  description String @default("")

  /// The person accountable, as a real account rather than a typed name - same reason as
  /// Department.manager.
  managerUserId String?
  manager       User?   @relation("ProjectManager", fields: [managerUserId], references: [id], onDelete: SetNull)

  startDate DateTime?
  endDate   DateTime?

  status ProjectStatus @default(planned)

  sites           Site[]
  reportSchedules ReportSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
}

model Site {
  id        String @id
  companyId String
  name      String
  /// Display fields for the organisation tree. Additive, with defaults.
  short     String @default("")
  city      String @default("")
  timezone  String @default("Asia/Kuching")
  headcount Int    @default(0)

  /// Company's own reference for the site, e.g. "BTU-01". Not unique across tenants.
  code         String   @default("")
  address      String   @default("")
  contactName  String   @default("")
  contactPhone String   @default("")
  /// Deactivated rather than deleted: incidents, permits and assets point here, and a
  /// site that stops existing takes their history with it.
  active       Boolean  @default(true)
  /// Optional, and permanently so. Sites predate projects, and a workspace that never
  /// adopts projects must keep working - so an unassigned site is a normal state, not a
  /// half-migrated one. Cleared rather than cascaded when a project goes: deleting a
  /// project must never take a site's incidents with it.
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// When this site's work runs. Distinct from the project's own dates: a project can
  /// open a site late and close it early.
  startDate DateTime?
  endDate   DateTime?

  /// Accountable people, as accounts rather than typed names. The existing contactName
  /// and contactPhone are kept for the gatehouse or a contractor who has no login.
  siteManagerUserId String?
  siteManager       User?   @relation("SiteManager", fields: [siteManagerUserId], references: [id], onDelete: SetNull)
  hseLeadUserId     String?
  hseLead           User?   @relation("SiteHseLead", fields: [hseLeadUserId], references: [id], onDelete: SetNull)

  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  incidents         Incident[]
  actions           CorrectiveAction[]
  permits           Permit[]
  assets            Asset[]
  inspections       Inspection[]
  audits            Audit[]
  obligations       ComplianceObligation[]
  documents         ComplianceDocument[]
  employees         Employee[]
  contractorWorkers ContractorWorker[]
  sessions          TrainingSession[]
  departments       Department[]
  visitors          Visitor[]
  toolboxMeetings   ToolboxMeeting[]
  manHours          SiteManHours[]

  @@index([companyId])
  @@index([projectId])
}

/// A department within a site. Employees carry the resolved department name for course
/// applicability; this is the structure the organisation tree renders and the place a
/// rename belongs.
model Department {
  id     String @id
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name          String
  code          String  @default("")
  /// The person accountable for this department. A real user, not a typed-in name: the
  /// visitor register showed what happens when identity is inferred from a display name.
  managerUserId String?
  manager       User?   @relation("DepartmentManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  /// Deactivated departments disappear from pickers but stay readable on the incidents,
  /// permits and visitors that already reference them.
  active        Boolean @default(true)

  teams Team[]

  createdAt DateTime   @default(now())
  visitors  Visitor[]
  incidents Incident[]

  @@index([siteId])
  @@index([siteId, active])
}

model Team {
  id           String     @id
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  name String
  lead String @default("")

  createdAt DateTime @default(now())

  @@index([departmentId])
}

// ─── Incidents ───────────────────────────────────────────────────────────────

enum IncidentType {
  near_miss
  first_aid
  mtc
  rwc
  lti
  fatality
  property_damage
  environmental
  vehicle
  fire
  unsafe_act
  unsafe_condition
  /// Appended for the enterprise classification set. The values above stay valid: rows
  /// already carry them, and a first-aid case reported last year is still a first-aid case.
  injury
  chemical_spill
  security
  occupational_illness
  equipment_failure
}

/// Outcome-based severity.
///
/// The first four are the original scale and remain valid - thousands of rows carry them
/// and rewriting history to fit a new scale would be a lie. The appended values are the
/// classification an HSE department actually reports on, because "lost time injury" is a
/// regulatory category and "Serious" is an opinion.
enum IncidentSeverity {
  Minor
  Moderate
  Serious
  Critical
  near_miss
  medical_treatment
  restricted_work
  lost_time_injury
  fatality
  environmental_major
  catastrophic
}

/// Investigation workflow. Ordered; transitions are validated server-side.
enum IncidentStage {
  reported
  assessment
  investigation
  rca
  actions
  review
  verification
  closed
  /// A report started and not yet submitted. Appended rather than inserted first: enum
  /// order is storage order, not workflow order, and the workflow is defined in code.
  draft
}

/// Rate-limit counters, one row per bucket (an IP, or an IP and a route).
///
/// In Postgres rather than in the API's memory, because an in-memory counter is not
/// actually a limit: it resets on every deploy, crash and restart, and two API instances
/// each keep their own, so the effective ceiling is the configured one multiplied by however
/// many processes happen to be running.
///
/// Rows are disposable. Losing this table costs nothing but a window's worth of counting,
/// which is why it carries no relations and is excluded from the tenant export - it is
/// operational state, not customer data, and the keys are IP addresses.
model RateLimit {
  /// Whatever express-rate-limit hands us: usually an IP, prefixed per limiter.
  key       String   @id
  hits      Int      @default(0)
  /// End of the current window. Past this, the next increment starts a new one.
  ///
  /// Timestamptz, unlike most DateTime columns here, because this one is written by raw SQL
  /// and compared both in Postgres and in JavaScript. A plain `timestamp` has no offset, so
  /// a JS Date sent through $queryRaw is serialised as local time, stored naively, and read
  /// back as if it were UTC - on a UTC+8 machine that is an eight-hour error, and it makes
  /// `NOW()` in SQL and `new Date()` in JS disagree about whether a window has ended.
  /// Measured: written 09:37:39Z, read back 17:37:39Z.
  expiresAt DateTime @db.Timestamptz(3)

  /// Only used by the sweep that deletes finished windows.
  @@index([expiresAt])
}

model Incident {
  id     String @id @default(cuid())
  /// Human reference (INC-####). Unique per tenant, not globally: two companies each
  /// run their own sequence and both legitimately have an INC-2601.
  number String

  /// Idempotency key supplied by the reporter's browser, so a report that is sent twice
  /// creates one incident.
  ///
  /// This exists because of how reports are actually filed: on a phone, on a site, on a
  /// connection that drops. The browser queues the report and retries, and a retry cannot
  /// tell the difference between "the request never arrived" and "it arrived, committed,
  /// and the response was lost on the way back". Without a key the second case silently
  /// files the injury twice — which is not a cosmetic duplicate, it double-counts in the
  /// safety statistics and in anything reported to DOSH from them.
  ///
  /// Nullable, and unique only per company: reports filed from the UI before this existed
  /// have none, and NULLs do not collide in a Postgres unique index, so any number of rows
  /// may leave it empty.
  clientRef String?

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  title       String
  description String           @default("")
  type        IncidentType
  severity    IncidentSeverity
  stage       IncidentStage    @default(reported)

  department       String      @default("")
  /// Set when the report names a department from the register rather than typing one.
  /// The text above is kept regardless, so a department being renamed or removed does not
  /// rewrite what the report said at the time.
  departmentId     String?
  departmentRef    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location         String
  gps              String?
  immediateActions String      @default("")

  /// Conditions at the time. Weather and shift are the two that turn up in causal analysis
  /// often enough to be worth structuring - night shift and heavy rain are not incidental.
  weather String @default("")
  shift   String @default("")

  /// Whether the emergency response plan was activated. A separate fact from severity: a
  /// near miss can trigger a muster, and a lost-time injury might not.
  emergencyResponseActivated Boolean @default(false)

  reporter     String
  reporterId   String?
  /// Reported without attribution. The reporter columns are still written - somebody has
  /// to be able to follow up - but the API withholds them from anyone below HSE manager.
  anonymous    Boolean @default(false)
  investigator String?

  /// The investigation proper.
  leadInvestigator         String?
  investigationTeam        String    @default("")
  investigationStartedAt   DateTime?
  investigationCompletedAt DateTime?
  /// What happened. Distinct from the root cause: the direct cause is the unsafe act or
  /// condition, the underlying cause is why it was there.
  directCause              String?
  underlyingCause          String?
  rootCause                String?
  contributingFactors      String?
  recommendations          String?
  /// Ishikawa categories: { manpower, machine, method, material, measurement, environment }
  rcaFishbone              Json?

  /// Set during assessment; drives the high-risk flag on Mission Control.
  /// Seriousness as an orderable number, maintained on write.
  ///
  /// Postgres sorts an enum by declaration order, and severity values have been appended
  /// over time - so `ORDER BY severity DESC` put a near miss above a legacy Critical and
  /// buried the serious incidents. A rank column is the only way to sort by meaning in the
  /// database, which is where sorting has to happen for pagination to be correct.
  severityRank Int @default(0)

  riskRating        String?
  potentialSeverity IncidentSeverity?
  highRisk          Boolean           @default(false)

  findings  String?
  closeNote String?

  /// Contributing causes: [{ id, category, description }]
  rcaCauses     Json?
  /// Five Whys: { problem, whys: string[], rootStatement }
  rcaFiveWhys   Json?
  rcaApprovedBy String?
  rcaApprovedAt DateTime?

  occurredAt DateTime
  reportedAt DateTime  @default(now())
  closedAt   DateTime?

  archived Boolean @default(false)
  /// Incremented on every mutation — lets the client detect a stale write.
  version  Int     @default(1)

  events      IncidentEvent[]
  comments    IncidentComment[]
  attachments IncidentAttachment[]
  actions     CorrectiveAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite indexes matching the actual list queries (company+stage, company+site).
  equipmentLinks IncidentEquipment[]
  people         IncidentPerson[]
  links          IncidentLink[]

  @@unique([companyId, number])
  @@unique([companyId, clientRef])
  @@index([companyId, stage])
  @@index([companyId, siteId])
  @@index([companyId, severityRank])
  @@index([companyId, occurredAt])
  @@index([companyId, type])
  @@index([reportedAt])
}

/// Append-only audit trail for an incident. Never updated or deleted.
model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  action    String
  detail    String?
  actor     String
  actorRole String?
  at        DateTime @default(now())

  @@index([incidentId, at])
}

/// Server-owned counter for human-readable references. A row per company keeps
/// INC numbering per-tenant and lets allocation happen inside a transaction, so
/// two simultaneous reports cannot receive the same number.
model Counter {
  companyId String
  /// Sequence name within the tenant: "incident", "capa", ...
  kind      String
  next      Int    @default(1)

  // Composite primary key. A single-column @id would make the sequence name globally
  // unique, so the first tenant to allocate "incident" would lock out every other one.
  @@id([companyId, kind])
}

// ─── Incident collaboration & corrective actions ─────────────────────────────

model IncidentComment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  body      String
  author    String
  authorId  String?
  /// Names mentioned with @ — drives notification fan-out.
  mentions  String[] @default([])
  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
}

model IncidentAttachment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  /// Original client filename, retained for display only — never used as a path.
  originalName String
  /// Server-generated name actually written to disk. Prevents path traversal and collisions.
  storedName   String  @unique
  mimeType     String
  sizeBytes    Int
  /// SHA-256 of the bytes as written at upload, so a file can be shown to be the one that
  /// was uploaded. Nullable: everything stored before this column existed has no digest,
  /// and an absent digest means "unverifiable", never "verified".
  checksum     String?
  uploadedBy   String
  uploadedById String?

  /// The corrective action this file is evidence for, when it is evidence for one.
  ///
  /// Null for evidence attached to the incident generally. One table rather than a second
  /// attachment model, so there is one upload route, one allow-list and one storage
  /// contract - the file is the same kind of thing either way.
  actionId String?
  action   CorrectiveAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@index([actionId])
}

model CapaNote {
  id       String           @id @default(cuid())
  actionId String
  action   CorrectiveAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  body      String
  author    String
  authorId  String?
  mentions  String[] @default([])
  createdAt DateTime @default(now())

  @@index([actionId, createdAt])
}

enum CapaSource {
  incident
  audit
  inspection
  manual
  training
}

enum CapaStatus {
  open
  in_progress
  completed
  verified
  cancelled
}

enum CapaPriority {
  Low
  Medium
  High
  Critical
}

/// Corrective and preventive action. The SAIL replacement: every item has an owner
/// and a target completion date, and closure requires verification by a manager.
model CorrectiveAction {
  id         String     @id @default(cuid())
  /// CA-#### — per tenant, same reasoning as Incident.number.
  code       String
  /// Null for actions raised outside an investigation — an audit finding, an inspection
  /// failure, or a manual entry. The Actions register (SAIL) is the union of both, so
  /// this must be optional or those items have nowhere to live.
  incidentId String?
  incident   Incident?  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  /// Where the action came from, for filtering and reporting.
  source     CapaSource @default(incident)

  // Real foreign keys, not bare strings. Without them a standalone action (incidentId
  // null) has no cascade path, so deleting a tenant orphans its safety records, and
  // nothing stops an action being written against a company that does not exist.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  title    String
  detail   String       @default("")
  owner    String
  ownerId  String?
  dueDate  DateTime
  priority CapaPriority @default(Medium)
  status   CapaStatus   @default(open)

  /// Evidence the owner supplies when marking complete.
  /// Whether closing this action demands evidence. Set when the action is raised, because
  /// deciding after the fact that proof was needed is how actions get closed on a promise.
  evidenceRequired Boolean   @default(false)
  evidenceNote     String?
  completedAt      DateTime?

  /// Verification is a separate act by a manager — completing is not closing.
  verifiedBy String?
  verifiedAt DateTime?

  cancelledReason String?

  /// Set when an inspection failure raised this action. Both are additive and nullable:
  /// every existing action keeps `null` and behaves exactly as before. They exist because
  /// an asset's open-defect count and an inspection's action list are two different
  /// questions, and deriving either one from the other loses rows.
  assetId      String?
  asset        Asset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  /// Back-reference only — the foreign key lives on AuditFinding, so this adds no column
  /// to CorrectiveAction and every existing action is unaffected.
  finding AuditFinding?

  notes CapaNote[]

  version       Int                  @default(1)
  createdBy     String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  evidence      IncidentAttachment[]
  fieldEvidence FieldEvidence[]

  @@unique([companyId, code])
  @@index([companyId, status])
  // Restored, not added: the standalone_actions migration created this index and a later
  // schema edit dropped the declaration without a migration. The register filters by
  // source, so leaving the drift in place makes the next `migrate dev` delete a live index.
  @@index([companyId, source])
  @@index([incidentId])
  @@index([dueDate])
  @@index([owner])
  /// Account-first ownership: see api/src/lib/actionOwner.ts.
  @@index([companyId, ownerId])
  @@index([assetId])
  @@index([inspectionId])
}

// ─── Permit to Work ──────────────────────────────────────────────────────────
// A permit authorises high-risk work for a bounded window. Every gate that makes it a
// control rather than a form — confirmed precautions, a passing gas test, released
// isolations, a handback signature — is enforced in permitService, not in the client.

enum PermitType {
  hot_work
  confined_space
  working_at_height
  electrical_isolation
  excavation
  lifting_operation
  line_breaking
  radiography
  // Added later. Enum values are append-only in Postgres, so the original eight keep
  // their positions and no existing permit changes meaning.
  loto
  cold_work
  pressure_testing
  vehicle_entry
}

/// Stored lifecycle states only.
///
/// `expired` is deliberately absent: it is not a state anyone writes, it is what an
/// approved or active permit *becomes* once the clock passes `validTo`. Storing it would
/// need a job to keep the column true, and any window where that job had not run would
/// report expired work as live — exactly the failure the permit exists to prevent.
/// The service derives it on read instead, so it is correct the instant it happens.
enum PermitStatus {
  draft
  submitted
  approved
  active
  suspended
  closed
  rejected
  /// The approval chain between submission and approval. A permit sits with the
  /// supervisor, then HSE, then the area authority who actually owns the plant.
  supervisor_review
  hse_review
  area_authority
  /// Archived: closed and filed. Excluded from every live view, kept for the record.
  archived
}

enum PermitSignatureRole {
  applicant
  approver
  closer
}

model Permit {
  id   String @id @default(cuid())
  /// Human reference (PTW-####). Per tenant, same reasoning as Incident.number.
  code String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  type        PermitType
  title       String
  description String     @default("")
  department  String     @default("")
  location    String

  applicant           String
  /// Legacy free-text contractor name. Superseded by contractorCompanyId; retained so
  /// permits raised before the contractor register existed still read correctly.
  contractor          String?
  /// The engaged firm. Validated at assignment: a suspended contractor cannot be named.
  contractorCompanyId String?
  contractorCompany   ContractorCompany? @relation(fields: [contractorCompanyId], references: [id], onDelete: SetNull)
  workerCount         Int                @default(1)

  /// Pre-start briefing. A permit issued without one is the single most common finding
  /// in a post-incident review, so it is recorded rather than assumed.
  toolboxAt DateTime?
  toolboxBy String?

  /// Job safety analysis / risk assessment reference and sign-off.
  jsaReference String?
  jsaConfirmed Boolean @default(false)

  /// PPE the issuer requires for this job, beyond site-standard.
  requiredPpe String[] @default([])

  /// Mandatory PPE acknowledged by the issuer at activation. Recorded rather than
  /// assumed: "the harness was on the list" and "the harness was checked" differ.
  ppeAcknowledgedAt DateTime?
  ppeAcknowledgedBy String?

  attendees   PermitAttendee[]
  extensions  PermitExtension[]
  equipment   PermitEquipment[]
  jsaSteps    PermitJsaStep[]
  attachments PermitAttachment[]

  /// Authorised window. The permit is only a permit between these two instants; the
  /// maximum span allowed depends on the type (see PERMIT_MAX_HOURS).
  validFrom DateTime
  validTo   DateTime

  status PermitStatus @default(draft)

  approver        String?
  approvedAt      DateTime?
  rejectionReason String?
  suspendedReason String?

  closedBy          String?
  closedAt          DateTime?
  /// Site handed back clean, tools removed, isolations released.
  handbackConfirmed Boolean   @default(false)

  /// Set when an incident occurred under this permit.
  linkedIncidentId String?

  controls   PermitControl[]
  isolations IsolationPoint[]
  gasTests   GasTest[]
  signatures PermitSignature[]
  timeline   PermitEvent[]

  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, siteId])
  @@index([companyId, type])
  // Created by an earlier migration and missing here, so `prisma migrate dev` would have
  // generated a migration dropping it. Declared so the schema describes the database.
  @@index([contractorCompanyId])
  // The board is ordered by urgency and the expiry sweep asks "what lapses next",
  // so validTo is the column both hot paths sort and filter on.
  @@index([validTo])
}

/// A precaution the issuer confirms on site. Required ones block issue until confirmed.
model PermitControl {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  /// Checklist order for the type. Rows would otherwise come back unordered, and a
  /// precaution list that reshuffles between reads is not one anyone can work down.
  position Int
  label    String
  required Boolean @default(true)

  confirmed   Boolean   @default(false)
  confirmedBy String?
  confirmedAt DateTime?
  note        String?

  @@index([permitId, position])
}

/// An energy source locked out and tagged. A permit cannot close while one is still applied.
model IsolationPoint {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  description String
  /// The physical lock/tag identifier, e.g. "LOTO-4471".
  tagId       String
  isolatedBy  String?
  isolatedAt  DateTime?
  removedBy   String?
  removedAt   DateTime?

  @@index([permitId])
}

/// Atmospheric readings. `pass` is computed server-side from GAS_LIMITS and stored, so
/// the verdict a permit was issued on stays readable even if the limits are later revised.
model GasTest {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  testedAt DateTime @default(now())
  testedBy String

  oxygenPct Float
  lelPct    Float
  h2sPpm    Float
  coPpm     Float
  pass      Boolean
  note      String?

  @@index([permitId, testedAt])
}

/// Who signed what, and the statement they signed. Append-only.
model PermitSignature {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  role      PermitSignatureRole
  name      String
  signedAt  DateTime            @default(now())
  statement String

  @@index([permitId, signedAt])
}

/// Append-only audit trail for a permit. Never updated or deleted.
model PermitEvent {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  action    String
  detail    String?
  actor     String
  actorRole String?
  at        DateTime @default(now())

  @@index([permitId, at])
}

// ─── Assets & Inspections ────────────────────────────────────────────────────
// Assets are inspected on a schedule. A failed checklist item is not a note — it
// becomes a corrective action with an owner and a due date, because a defect nobody
// is accountable for is a defect that stays on the plant.

enum AssetCategory {
  fire_extinguisher
  forklift
  ladder
  scaffolding
  machinery
  electrical_panel
  emergency_lighting
  first_aid_kit
  ppe
  vehicle
  pressure_vessel
  crane
  chain_block
  lifting_sling
  harness
  gas_detector
  scba
  pressure_gauge
  electrical_tool
  generator
  compressor
  custom
}

enum AssetStatus {
  in_service
  under_maintenance
  out_of_service
  retired
  /// In active use on a job. Distinct from in_service so a shared gas detector cannot be
  /// booked onto two permits at once.
  in_use
  /// Written off. Kept separate from retired so a disposal is auditable as a disposal.
  disposed
}

enum InspectionFrequency {
  daily
  weekly
  monthly
  quarterly
  annual
}

enum InspectionStatus {
  scheduled
  completed
  cancelled
}

enum InspectionOutcome {
  passed
  failed
}

model Asset {
  id    String @id @default(cuid())
  /// Human reference (AST-####). Per tenant, same reasoning as Incident.number.
  code  String
  /// Payload printed on the QR label. Separate from `code` so a label can be reissued
  /// without renumbering the asset, and so a stale label resolves to a clear 404.
  qrKey String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  name           String
  category       AssetCategory
  customCategory String?
  serialNumber   String
  manufacturer   String        @default("")
  model          String        @default("")

  purchaseDate   DateTime?
  commissionDate DateTime?
  warrantyUntil  DateTime?

  department String @default("")
  owner      String
  location   String @default("")

  status    AssetStatus         @default(in_service)
  frequency InspectionFrequency

  /// Safety-critical: failure of this item hurts someone directly. Drives the register's
  /// filters, the dashboard, and how loudly the reminder engine chases it.
  critical Boolean @default(false)

  /// Who currently holds it. Exactly one of these, or neither for pool equipment.
  assignedEmployeeId         String?
  assignedEmployee           Employee?         @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedContractorWorkerId String?
  assignedContractorWorker   ContractorWorker? @relation(fields: [assignedContractorWorkerId], references: [id], onDelete: SetNull)

  notes String?

  /// Calibration applies to measuring instruments only. Null on everything else, which is
  /// how the permit gate knows whether to demand a valid certificate.
  requiresCalibration Boolean @default(false)

  calibrations  Calibration[]
  permitUsages  PermitEquipment[]
  workOrders    WorkOrder[]
  incidentLinks IncidentEquipment[]
  events        AssetEvent[]

  lastInspectedAt DateTime?
  /// Date the next inspection falls due. Rolled forward on completion so an asset can
  /// never drop off the calendar by being inspected.
  nextDueDate     DateTime

  documents   AssetDocument[]
  inspections Inspection[]
  actions     CorrectiveAction[]

  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, qrKey])
  @@index([companyId, status])
  @@index([companyId, siteId])
  @@index([companyId, category])
  // Created by an earlier migration and missing here, so `prisma migrate dev` would have
  // generated a migration dropping it. Declared so the schema describes the database.
  @@index([companyId, critical])
  @@index([assignedEmployeeId])
  @@index([assignedContractorWorkerId])
  // The register sorts and filters on what is due, so this is the hot path.
  @@index([nextDueDate])
}

/// A file held against a piece of equipment: photos, manuals, certificates.
///
/// Same storage contract as permit documents and incident evidence - one way of handling
/// uploaded files in this codebase, not three. The file columns are nullable because rows
/// predating real storage exist; those render as a name with no download rather than a
/// broken link.
model AssetDocument {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  name String
  /// photo | manual | certificate | pdf | image
  kind String @default("pdf")

  /// The name the operator's device gave it. Shown, never used as a path.
  originalName String?
  /// A UUID chosen by the server. The only name that touches the filesystem.
  storedName   String?
  mimeType     String?
  sizeBytes    Int?
  /// SHA-256 of the bytes as written at upload, so a file can be shown to be the one that
  /// was uploaded. Nullable: everything stored before this column existed has no digest,
  /// and an absent digest means "unverifiable", never "verified".
  checksum     String?
  uploadedBy   String?
  uploadedById String?

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([assetId, kind])
}

model Inspection {
  id   String @id @default(cuid())
  /// Human reference (INS-####). Per tenant.
  code String

  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  scheduledFor DateTime
  assignedTo   String
  status       InspectionStatus @default(scheduled)

  completedAt DateTime?
  completedBy String?
  outcome     InspectionOutcome?

  /// The completed checklist: [{ itemId, label, result, comment?, measurement? }].
  /// Stored whole because it is written once at completion and always read as a unit —
  /// it is the record of what was checked, not a table anyone queries across.
  answers Json?

  comments   String?
  photoCount Int     @default(0)
  gps        String?
  signature  String?

  /// Defects raised from this inspection.
  actions  CorrectiveAction[]
  evidence FieldEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([assetId, scheduledFor])
  @@index([scheduledFor])
}

// ─── Audits & Compliance ─────────────────────────────────────────────────────
// An audit runs a checklist template. A failed item becomes a finding, and every
// finding raises a corrective action with an owner and a date. The audit cannot close
// until each of those actions is verified — that is what makes the register evidence
// rather than a report, and it is enforced in auditService, not in the client.

enum AuditType {
  internal
  external
  dosh
  iso45001
  customer
  contractor
  supplier
  environmental
  quality
  custom
}

enum AuditStatus {
  planned
  in_progress
  completed
  closed
}

enum AuditPriority {
  High
  Medium
  Low
}

enum FindingSeverity {
  Critical
  Major
  Minor
  Observation
}

enum DocKind {
  policy
  sop
  certificate
  inspection_report
  permit
  training_record
  audit_report
}

enum DocStatus {
  Draft
  PendingApproval
  Approved
  Superseded
}

/// A tenant-authored checklist. The built-in templates live in auditCatalog.ts and are
/// available to everyone; only custom ones are rows, which is why companyId is required
/// here — a template someone wrote belongs to the workspace that wrote it.
model AuditTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name     String
  type     AuditType @default(custom)
  /// [{ title, items: [{ id, text, guidance? }] }]
  sections Json

  createdBy String
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Audit {
  id   String @id @default(cuid())
  /// Human reference (AUD-####). Per tenant.
  code String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  title      String
  type       AuditType
  customType String?
  department String    @default("")

  leadAuditor String
  team        String[] @default([])
  /// Either a built-in catalogue id or an AuditTemplate row id. Not a foreign key
  /// because the built-ins are not rows; the service resolves both.
  templateId  String

  scheduledFor DateTime
  durationDays Int           @default(1)
  priority     AuditPriority @default(Medium)
  status       AuditStatus   @default(planned)

  startedAt   DateTime?
  completedAt DateTime?
  closedAt    DateTime?

  /// Percentage of applicable items that passed. N/A answers are excluded, so a
  /// checklist half of which does not apply is not scored as half-failed.
  score     Int?
  /// [{ itemId, section, text, result, comment?, photoCount? }]
  answers   Json?
  signature String?
  gps       String?

  findings AuditFinding[]
  timeline AuditEvent[]
  evidence FieldEvidence[]

  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, siteId])
  @@index([companyId, type])
  @@index([scheduledFor])
}

model AuditFinding {
  id   String @id @default(cuid())
  /// Human reference (F-####). Per tenant.
  code String

  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  /// The checklist section the failure came from.
  category    String
  description String
  severity    FindingSeverity

  evidenceNote     String?
  photoCount       Int     @default(0)
  linkedAssetId    String?
  linkedIncidentId String?

  /// The corrective action raised for this finding. One-to-one: a finding without an
  /// owned action is a note, and the audit cannot close on notes.
  actionId String           @unique
  action   CorrectiveAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  raisedBy String
  raisedAt DateTime @default(now())

  @@index([auditId])
}

/// Append-only audit trail for an audit. Never updated or deleted.
model AuditEvent {
  id      String @id @default(cuid())
  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  action    String
  detail    String?
  actor     String
  actorRole String?
  at        DateTime @default(now())

  @@index([auditId, at])
}

/// A statutory or contractual obligation with a renewal date. Status is derived from
/// nextDue on read, for the same reason permit expiry is.
model ComplianceObligation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Null means organisation-wide rather than tied to one site.
  siteId    String?
  site      Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  regulation  String
  requirement String
  responsible String

  nextDue       DateTime
  expiryDate    DateTime?
  evidenceDoc   String?
  notes         String?
  lastRenewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, nextDue])
}

model ComplianceDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name    String
  kind    DocKind
  version String    @default("1.0")
  status  DocStatus @default(PendingApproval)
  owner   String
  sizeKb  Int       @default(0)

  approvedBy String?
  approvedAt DateTime?

  versions DocumentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, kind])
}

/// One row per uploaded revision. Append-only: superseding a version records a new row
/// rather than overwriting, so the approval history of a controlled document survives.
model DocumentVersion {
  id         String             @id @default(cuid())
  documentId String
  document   ComplianceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  version String
  note    String   @default("")
  by      String
  at      DateTime @default(now())

  @@index([documentId, at])
}

// ─── Training & Competency ───────────────────────────────────────────────────
// Courses define what competency looks like; sessions deliver it; certificates carry
// an expiry. The matrix and every compliance figure are derived from certificates on
// read — a stored "competent" flag is a flag that is wrong the day a cert lapses.

enum CourseCategory {
  induction
  safety
  equipment
  emergency
  health
  environmental
  custom
}

enum DeliveryMode {
  online
  physical
}

enum SessionStatus {
  scheduled
  completed
  cancelled
}

enum AttendanceResult {
  pass
  fail
}

/// The workforce. Training hangs off real people, so this is a table rather than a
/// client-side fixture. Departments arrive with the organisation migration; until then
/// the resolved department name is carried here, which is what course applicability
/// actually matches on.
model Employee {
  id        String  @id @default(cuid())
  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// Retained for the organisation migration; not yet a foreign key.
  departmentId String?
  department   String  @default("")
  teamId       String?

  /// EMP-#### per company. People are referred to by this on permits, toolbox talks and
  /// medical records, so it has to be stable and quotable rather than an internal id.
  employeeNo String @default("")

  name     String
  position String  @default("")
  email    String?
  phone    String?
  active   Boolean @default(true)

  hireDate DateTime?

  /// Fitness-to-work certificate expiry. This is the field that stops someone being
  /// allowed on a job: an expired medical is a legal bar on confined space, working at
  /// height and most hot work, so it is queried and reminded on, not filed away.
  medicalExpiry DateTime?
  bloodGroup    String?
  /// Restrictions a supervisor must know about — "no working at height", "wears glasses".
  medicalNotes  String?

  /// The login this person uses, when they have one. Optional because most workers on an
  /// HSE register never sign in - and nullable is what stops an invitation quietly
  /// creating a second Employee for somebody already on the books.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  enrolments        SessionEnrolment[]
  certificates      Certificate[]
  permitAttendances PermitAttendee[]
  assignedAssets    Asset[]
  emergencyContacts EmergencyContact[]
  ppeIssues         PpeIssue[]

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  visitorsHosted      Visitor[]        @relation("VisitorHost")
  incidentAppearances IncidentPerson[] @relation("IncidentPeople")

  @@unique([companyId, employeeNo])
  @@index([companyId])
  @@index([companyId, siteId])
  @@index([name])
  @@index([companyId, medicalExpiry])
}

/// Who to call when someone is hurt. A separate table rather than two columns because
/// the real answer is often "spouse, and the site clinic", and a next-of-kin list that
/// only holds one name is the sort of gap nobody notices until the day it matters.
model EmergencyContact {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name         String
  relationship String  @default("")
  phone        String
  altPhone     String?
  /// The one to ring first. Exactly one per employee is kept primary by the service.
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

/// Personal protective equipment issued to a person.
///
/// Tracked per issue rather than as a checkbox on the employee because the auditable
/// question is "when was this harness last replaced and who signed for it", and because
/// a replacement is a new issue, not an edit of the old one.
model PpeIssue {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  item         String
  size         String  @default("")
  /// Serial or asset tag where the item carries one — harnesses and respirators do.
  serialNumber String?

  issuedAt   DateTime  @default(now())
  issuedBy   String
  /// When it is due for replacement. Null for items with no service life.
  replaceDue DateTime?
  returnedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([companyId, replaceDue])
}

/// What someone is on a permit to do.
enum PermitAttendeeRole {
  /// Named in charge of the work on the ground.
  supervisor
  /// Accepts the permit from the issuer.
  receiver
  /// Doing the work.
  worker
  /// Watches the entry point on a confined space. Never counted as inside.
  standby
  gas_tester
}

/// A person named on a permit.
///
/// Exactly one of employeeId or contractorWorkerId is set — the permit does not care
/// whose payroll someone is on, but the register they came from decides which fitness
/// rules apply. Names are never free text here: a typo used to mean an unfit person
/// could be written onto a hot work permit and nothing would notice.
model PermitAttendee {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  contractorWorkerId String?
  contractorWorker   ContractorWorker? @relation(fields: [contractorWorkerId], references: [id], onDelete: Restrict)

  role PermitAttendeeRole @default(worker)

  /// Snapshot of the name at assignment, so a closed permit still reads correctly even
  /// if the person is later renamed or removed from the register.
  nameAtAssignment String
  addedBy          String
  addedAt          DateTime @default(now())

  /// Confined space entry tracking. Null until they go in, cleared when they come out.
  enteredAt DateTime?
  exitedAt  DateTime?

  /// Signed the toolbox talk. A permit cannot go active until everyone named has, which
  /// is the difference between a briefing that happened and one that was minuted.
  toolboxAckAt DateTime?

  @@index([permitId])
  @@index([employeeId])
  @@index([contractorWorkerId])
}

/// One line of a job safety analysis.
///
/// Rows rather than a prose field, because a JSA is only useful if each hazard has a
/// named control and a named person: free text produces "usual precautions apply", which
/// is what an investigation finds when nobody can say who was responsible for what.
///
/// Versioned at the permit level — editing any row bumps the permit version and writes a
/// timeline entry, so a JSA cannot be quietly rewritten after an incident.
model PermitJsaStep {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  /// Display order. The sequence of the job, not a priority.
  sequence Int @default(0)

  step         String @default("")
  hazard       String
  risk         String @default("")
  control      String
  responsible  String @default("")
  /// Risk remaining once the control is in place. The number an approver actually judges.
  residualRisk String @default("")

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([permitId])
}

/// A document attached to a permit.
///
/// Same storage contract as incident evidence: the file is written to UPLOAD_DIR under a
/// server-generated name, and the original filename is kept for display only so it can
/// never be used as a path.
model PermitAttachment {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  /// What the document is, so a permit pack can be assembled and checked for gaps.
  kind PermitAttachmentKind @default(other)

  originalName String
  storedName   String  @unique
  mimeType     String
  sizeBytes    Int
  /// SHA-256 of the bytes as written at upload, so a file can be shown to be the one that
  /// was uploaded. Nullable: everything stored before this column existed has no digest,
  /// and an absent digest means "unverifiable", never "verified".
  checksum     String?
  uploadedBy   String
  uploadedById String?

  createdAt DateTime @default(now())

  @@index([permitId])
}

enum PermitAttachmentKind {
  method_statement
  jsa
  gas_test_sheet
  isolation_certificate
  photo
  other
}

/// A calibration certificate for a measuring instrument.
///
/// Kept as history rather than columns on the asset, because "when was this gas detector
/// last calibrated, by whom, against which certificate" is the question an auditor asks
/// and a coroner asks. The current certificate is the most recently issued one, derived
/// on read so a recalibration supersedes automatically.
model Calibration {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  calibratedAt      DateTime
  /// Certificate reference from the calibration house. Quoted externally.
  certificateNumber String
  vendor            String   @default("")
  /// When it lapses. An instrument past this reads numbers nobody should trust.
  expiresAt         DateTime

  result  CalibrationResult @default(pass)
  remarks String?

  /// The scanned certificate, same storage contract as permit documents.
  documentName String?
  storedName   String?

  recordedBy String
  createdAt  DateTime @default(now())

  @@index([assetId, calibratedAt])
  @@index([expiresAt])
}

enum CalibrationResult {
  pass
  pass_with_adjustment
  fail
}

/// Equipment booked onto a permit.
///
/// This is the join that makes the permit gate possible. A permit that names a gas
/// detector is claiming that instrument will be used on the job, so the permit cannot go
/// active unless the instrument is fit: in service, inspection current, and — for a
/// measuring instrument — calibration valid.
model PermitEquipment {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  assetId  String
  /// Restrict: equipment named on a permit is part of that permit's record.
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  /// What it is there for, in the issuer's words.
  purpose String @default("")

  addedBy String
  addedAt DateTime @default(now())

  @@unique([permitId, assetId])
  @@index([permitId])
  @@index([assetId])
}

/// A permit extension.
///
/// Kept as history rather than overwriting validTo, because "how long was this job
/// actually authorised for, and who kept extending it" is the question asked when the
/// job overruns into a shift nobody planned for.
model PermitExtension {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  previousValidTo DateTime
  newValidTo      DateTime
  reason          String

  requestedBy    String
  requestedAt    DateTime  @default(now())
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?

  @@index([permitId])
}

// ─── Contractors ─────────────────────────────────────────────────────────────

enum ContractorStatus {
  active
  suspended
}

/// A contracting firm working on the tenant's sites.
///
/// Separate from Company, which is the tenant itself: a contractor has no login, no
/// workspace and no data of its own here. What it has is an insurance certificate that
/// expires, and that expiry is the reason this table exists — an uninsured contractor on
/// site is the tenant's liability, not the contractor's.
model ContractorCompany {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// CON-#### per tenant. Quoted on permits and gate passes.
  code String

  name               String
  /// Companies Commission registration (SSM in Malaysia). Blank until supplied.
  registrationNumber String  @default("")
  contactPerson      String  @default("")
  phone              String  @default("")
  email              String?
  address            String  @default("")

  /// Public liability / workmen's compensation expiry. The date that stops them working.
  insuranceExpiry DateTime?

  status ContractorStatus @default(active)

  workers ContractorWorker[]
  permits Permit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, insuranceExpiry])
}

/// An individual working for a contractor on one of the tenant's sites.
///
/// Deliberately not an Employee: they are not on the payroll, their competencies are
/// evidenced by the contractor rather than issued here, and they come and go. What they
/// share with an employee is that an expired medical or induction bars them from site.
model ContractorWorker {
  id                  String            @id @default(cuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractorCompanyId String
  contractorCompany   ContractorCompany @relation(fields: [contractorCompanyId], references: [id], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// CW-#### per tenant.
  workerNo String

  name       String
  /// National ID or passport. The only identifier a contractor worker reliably carries,
  /// and what a gate check is done against.
  icPassport String @default("")
  position   String @default("")

  /// Fitness to work, same bar as an employee's.
  medicalExpiry   DateTime?
  /// Site induction. Lapses far more often than a medical because it is annual and
  /// nobody schedules it.
  inductionExpiry DateTime?

  emergencyName     String @default("")
  emergencyPhone    String @default("")
  emergencyRelation String @default("")

  /// Gate state. Set by check-in and cleared by check-out, so "who is on site right now"
  /// is a query rather than a paper book in a cabin.
  onSite      Boolean   @default(false)
  checkedInAt DateTime?

  active Boolean @default(true)

  certificates      ContractorCertificate[]
  permitAttendances PermitAttendee[]
  assignedAssets    Asset[]

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  incidentAppearances IncidentPerson[] @relation("IncidentPeople")

  @@unique([companyId, workerNo])
  @@index([companyId])
  @@index([contractorCompanyId])
  @@index([companyId, medicalExpiry])
  @@index([companyId, inductionExpiry])
  @@index([companyId, onSite])
}

/// Competency evidence supplied by the contractor.
///
/// Not a Certificate: that model is proof this tenant trained someone and carries a
/// verifiable number. This is a scan of somebody else's paperwork, trusted only as far
/// as the expiry date written on it.
model ContractorCertificate {
  id       String           @id @default(cuid())
  workerId String
  worker   ContractorWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  name       String
  issuedBy   String    @default("")
  issueDate  DateTime?
  expiryDate DateTime?
  reference  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
}

/// A tenant-authored course. The standard catalogue lives in trainingCatalog.ts and is
/// available to everyone, same arrangement as the audit templates.
model TrainingCourse {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String
  name        String
  category    CourseCategory @default(custom)
  description String         @default("")

  mandatory      Boolean        @default(false)
  /// Null means a one-time competency that never expires.
  validityMonths Int?
  durationHours  Float          @default(1)
  deliveryModes  DeliveryMode[] @default([])
  competency     String         @default("")
  passMark       Int            @default(80)
  /// Department keywords the course applies to. Empty means the whole workforce.
  applies        String[]       @default([])

  createdBy String
  createdAt DateTime @default(now())

  @@unique([companyId, code])
  @@index([companyId])
}

model TrainingSession {
  id   String @id @default(cuid())
  /// Human reference (SES-###). Per tenant.
  code String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// Either a catalogue id or a TrainingCourse row id — the service resolves both, so
  /// this is not a foreign key.
  courseId   String
  courseName String

  trainer         String
  venue           String       @default("")
  mode            DeliveryMode @default(physical)
  scheduledFor    DateTime
  durationHours   Float        @default(1)
  maxParticipants Int          @default(20)

  status      SessionStatus @default(scheduled)
  signature   String?
  completedAt DateTime?
  completedBy String?

  enrolments   SessionEnrolment[]
  certificates Certificate[]

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([scheduledFor])
}

/// One row per seat. Carries the enrolment before the session and the attendance
/// afterwards, so a seat booked and a seat sat are the same record.
model SessionEnrolment {
  id         String          @id @default(cuid())
  sessionId  String
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  present Boolean           @default(false)
  result  AttendanceResult?
  score   Int?

  createdAt DateTime @default(now())

  // One seat per person per session — enrolling twice is a mistake, not two seats.
  @@unique([sessionId, employeeId])
  @@index([employeeId])
}

/// Proof of competency, with an expiry taken from the course validity at issue.
/// A renewal is a new row; the current certificate for an employee and course is the
/// most recently issued one, derived on read so a renewal supersedes automatically.
model Certificate {
  id     String @id @default(cuid())
  /// CERT-YYYY-####. Unique across the deployment because it is quoted externally and
  /// verified by anyone holding the number.
  number String @unique
  /// Payload behind the printed QR code.
  qrKey  String @unique

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  courseId   String
  courseName String

  sessionId String?
  session   TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  issueDate  DateTime
  /// Null for a competency with no expiry.
  expiryDate DateTime?
  issuedBy   String
  score      Int?
  docName    String?

  createdAt DateTime @default(now())

  @@index([employeeId, courseId, issueDate])
  @@index([companyId])
  @@index([expiryDate])
}

// ─── Administration ──────────────────────────────────────────────────────────
// Governance, security and integrations. User lifecycle, roles and login history are
// NOT modelled again here — they operate on the real User, Membership and LoginAttempt
// tables above. An admin console that manages a parallel copy of the users manages
// nothing, so everything below is the state that genuinely has nowhere else to live.

/// A role's permission matrix, per tenant.
///
/// Note what this is and is not: the matrix is the console's declaration of what a role
/// should be able to do. Service-layer authorisation still switches on Membership.role
/// directly, so editing a cell here does not silently re-open an endpoint. Wiring the
/// two together is a deliberate, separate change.
model RoleDefinition {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Matches Membership.role for the built-in roles; custom roles carry their own slug.
  roleId      String
  name        String
  description String  @default("")
  /// System roles cannot be deleted or reduced below their definition.
  system      Boolean @default(false)
  /// { module: action[] }
  permissions Json

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, roleId])
  @@index([companyId])
}

/// Append-only administrative trail. Never updated or deleted by the application;
/// pruning is the retention policy's job, not a feature of the console.
/// Platform-level audit: privilege changes that belong to no customer.
///
/// Deliberately a separate table from AdminAuditEntry rather than making that one's
/// companyId nullable. Granting cross-tenant access has no company to hang off, and a
/// nullable foreign key there would let platform rows surface in queries that every
/// tenant-scoped screen runs. Isolation by construction beats isolation by remembering to
/// filter.
///
/// Never holds a password, a hash or a token - only who did what, to whom, and how it
/// turned out.
model PlatformAuditEntry {
  id String @id @default(cuid())

  /// platform_admin_granted | platform_admin_revoked | platform_admin_bootstrapped
  action  String
  /// applied | no_change | refused
  outcome String

  /// Whoever held the shell. There is no session here: this is an operator act at the
  /// server, so the OS user and host are the only identity available, and saying so is
  /// more honest than inventing one.
  actor     String
  actorHost String @default("")
  /// How it was performed, so a future in-product path is distinguishable from the CLI.
  source    String @default("cli")

  targetEmail  String
  targetUserId String?

  /// Why a refusal happened, or what changed. Free text, never a secret.
  detail String?

  at DateTime @default(now())

  @@index([at])
  @@index([targetEmail])
}

model AdminAuditEntry {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actor     String
  actorRole String  @default("")
  action    String
  /// mission_control | incidents | ... | auth | system
  module    String
  target    String  @default("")
  ip        String  @default("")
  device    String  @default("")
  oldValue  String?
  newValue  String?

  at DateTime @default(now())

  @@index([companyId, at])
  @@index([companyId, module])
}

/// An issued API key.
///
/// Only a SHA-256 digest of the secret is stored — the same rule as RefreshToken. The
/// plaintext is returned exactly once, at creation, and cannot be recovered afterwards,
/// so a database leak does not hand an attacker working credentials.
model ApiKey {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String
  /// First characters of the key, shown so a human can tell two keys apart.
  prefix    String
  /// SHA-256 of the full secret. Never the secret itself.
  tokenHash String   @unique
  scopes    String[] @default([])

  lastUsedAt DateTime?
  revoked    Boolean   @default(false)
  revokedAt  DateTime?

  createdBy String
  createdAt DateTime @default(now())

  usage ApiUsageDay[]

  @@index([companyId, revoked])
}

/// One row per key per day: what the integration API actually served.
///
/// A rollup rather than a request log. The console wants "calls today" and a seven-day
/// series, and keeping every request to answer that would be a second, larger, and far
/// more sensitive dataset - request paths carry incident ids. Counts answer the question
/// asked and carry nothing about who or what was read.
///
/// Replaces ApiKey.callsToday, which was set to 0 at issuance and never incremented, so
/// the console's usage figure was always zero and its "reset at midnight" was nobody's
/// job. A day-keyed row has no reset.
model ApiUsageDay {
  id        String @id @default(cuid())
  apiKeyId  String
  apiKey    ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  /// Denormalised so a company's whole series is one indexed read rather than a join
  /// across every key it has ever issued. For the query, not for retention: these rows
  /// cascade away with the key.
  companyId String

  /// UTC midnight of the day being counted, matching every other date-only value here.
  day    DateTime
  calls  Int      @default(0)
  errors Int      @default(0)

  @@unique([apiKeyId, day])
  @@index([companyId, day])
}

model Webhook {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  url        String
  events     String[] @default([])
  active     Boolean  @default(true)
  /// The signing secret, sealed with AES-256-GCM. See secretBox.ts.
  ///
  /// Encrypted and not hashed, which is the opposite of ApiKey.tokenHash and deliberate:
  /// a key is *verified* against what a caller presents, so a digest is enough and is
  /// strictly safer. A webhook secret is used to *produce* an HMAC over every payload we
  /// send, so this service has to be able to read it back. Hashing it - which is what this
  /// column used to hold - meant no signature could ever be computed, which is one of the
  /// reasons no webhook had ever been delivered.
  secretEnc  String
  /// Last four characters, so the console can show which secret is configured.
  secretTail String   @default("")

  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?
  lastDeliveryCode   Int?

  deliveries WebhookDelivery[]

  createdBy String
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// One attempt-tracked delivery of one event to one endpoint.
///
/// A queue, not a log. Events are enqueued inside the transaction-adjacent path that
/// produced them and sent by a sweep, because the alternative - posting inline - makes an
/// incident report wait on a customer's endpoint and fail when it is down. The payload is
/// frozen at enqueue time so a redelivery sends what the event said, not what the record
/// says now.
model WebhookDelivery {
  id        String  @id @default(cuid())
  webhookId String
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  companyId String

  event   String
  /// The exact JSON body that will be signed and sent.
  payload Json

  /// pending | delivered | failed. `failed` is terminal: attempts are exhausted.
  status        String   @default("pending")
  attempts      Int      @default(0)
  /// When this becomes sendable. Backoff moves it forward; a new row is due immediately.
  nextAttemptAt DateTime @default(now())

  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())

  /// The sweep's only question: what is pending and due.
  @@index([status, nextAttemptAt])
  @@index([companyId, createdAt])
}

/// A third-party integration's connection state. Credentials supplied when connecting
/// are stored as a digest, never in cleartext — the console only ever needs to show
/// that a field is set, not what it is.
model ConnectorConfig {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  connectorId String
  connected   Boolean @default(false)
  /// { fieldKey: "set" } — presence only, never the value.
  configSet   Json?

  connectedBy String?
  connectedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, connectorId])
}

/// Password and session policy. One row per tenant.
model SecurityPolicy {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  passwordMinLength   Int     @default(12)
  requireUppercase    Boolean @default(true)
  requireNumber       Boolean @default(true)
  requireSymbol       Boolean @default(false)
  passwordExpiryDays  Int     @default(90)
  lockoutThreshold    Int     @default(5)
  sessionTimeoutHours Int     @default(12)
  mfaRequired         Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model OrgSettings {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  displayName  String @default("")
  legalName    String @default("")
  industry     String @default("")
  timezone     String @default("Asia/Kuching")
  language     String @default("en-MY")
  brandAccent  String @default("#2F6FED")
  logoInitials String @default("")

  updatedAt DateTime @updatedAt
}

/// Job positions, shift patterns, holidays and business units.
///
/// One table rather than four: they are all small, free-shaped lists the console edits
/// as rows, none is referenced by another model, and four near-identical tables would
/// be four near-identical services.
model OrgConfigItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// position | shift | holiday | unit
  kind String
  data Json

  createdBy String
  createdAt DateTime @default(now())

  @@index([companyId, kind])
}

model RetentionPolicy {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  auditLogDays        Int     @default(365)
  backupCount         Int     @default(10)
  closedIncidentYears Int     @default(7)
  autoBackupDaily     Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// A restore point. The snapshot is the tenant's own data, exported as JSON.
model Backup {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sizeKb     Int     @default(0)
  by         String
  /// manual | auto | pre_restore
  type       String  @default("manual")
  note       String  @default("")
  restorable Boolean @default(true)
  /// The exported payload. Null once pruned by the retention policy.
  snapshot   Json?

  at DateTime @default(now())

  @@index([companyId, at])
}

// ─── Notifications ───────────────────────────────────────────────────────────

/// A workspace notification.
///
/// Addressed to the workspace rather than to one person, which is what the product
/// already does — an overdue action or a suspended permit is everyone's business. Read
/// state is per user (see NotificationRead), so one person clearing their bell does not
/// clear it for the whole site.
model Notification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// incident | action | audit | system
  kind   String
  title  String
  detail String  @default("")
  href   String?

  /// Who this is actually for.
  ///
  /// Null means the workspace feed, which is what every notification was before this and
  /// what broadcasts still are. A value means one person: the reporter, the investigator,
  /// the action owner. Nullable rather than required precisely so the existing behaviour
  /// is untouched - a feed notification is still a feed notification.
  recipientUserId String?
  /// The name at the time. A notification that says "assigned to you" has to still read
  /// correctly after the account is renamed or removed.
  recipientName   String?
  /// Why they are getting it, for the audit trail: reporter | investigator | capa_owner |
  /// safety_officer | hse_manager | department_manager
  recipientRole   String?

  reads NotificationRead[]

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([recipientUserId, createdAt])
  /// The scheduler asks "has this reminder already been raised?" by (companyId, href)
  /// once per candidate, thousands of times a sweep. Without this every one of those was
  /// a scan of the workspace's whole notification history, growing forever.
  @@index([companyId, href])
}

/// One row per person who has read a notification. Absence means unread, so a new user
/// does not inherit somebody else's cleared bell.
model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

/// Preventive, corrective or emergency work on a piece of equipment.
///
/// Separate from Inspection because the two answer different questions. An inspection asks
/// "is this still fit"; a work order records what was done about it, by whom, for how long
/// the item was down and at what cost. Conflating them loses the downtime figure, which is
/// the number a plant manager is actually judged on.
model WorkOrder {
  id      String @id @default(cuid())
  /// Human reference (WO-####), per tenant.
  code    String
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  kind        MaintenanceKind
  priority    MaintenancePriority @default(medium)
  description String

  assignedTo String @default("")

  /// Planned start. Set at raise time; what "overdue" is measured against.
  dueAt      DateTime?
  startedAt  DateTime?
  finishedAt DateTime?

  /// Minutes the equipment was unavailable. Recorded rather than derived from the
  /// start/finish stamps: a job can be paused overnight without the plant being down.
  downtimeMinutes Int @default(0)

  /// Stored in sen (1/100 of a ringgit) as an integer. Floating point money in a cost
  /// report eventually produces a total that does not match the sum of its rows.
  costSen   Int    @default(0)
  partsUsed String @default("")

  status MaintenanceStatus @default(open)

  raisedBy    String
  raisedAt    DateTime @default(now())
  closedBy    String?
  closingNote String?

  @@unique([assetId, code])
  @@index([assetId, status])
  @@index([status, dueAt])
}

enum MaintenanceKind {
  preventive
  corrective
  emergency
}

enum MaintenancePriority {
  low
  medium
  high
  critical
}

enum MaintenanceStatus {
  open
  in_progress
  completed
  cancelled
}

/// Equipment named on an incident.
///
/// A join table rather than a column on Incident because one incident can involve several
/// items - a sling parted and the load struck a scaffold - and because the same asset
/// accumulating incidents is the signal worth surfacing on its profile.
model IncidentEquipment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  /// What part this equipment played. Free text on purpose: "harness lanyard failed at
  /// the stitching" is worth more than an enum value of "failure".
  involvement String   @default("")
  addedBy     String
  addedAt     DateTime @default(now())

  @@unique([incidentId, assetId])
  @@index([assetId])
}

/// One line of an asset's history.
///
/// Written alongside the row that caused it, in the same transaction, so the timeline
/// cannot drift from the facts. Denormalised on purpose: reconstructing a history by
/// merging five tables at read time is how a timeline ends up missing the one event that
/// mattered, and this is the view an investigator reads after someone is hurt.
model AssetEvent {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  kind    AssetEventKind
  /// One sentence, already written for a human. Rendered as-is.
  summary String
  detail  String?

  actor     String
  actorRole String   @default("")
  at        DateTime @default(now())

  /// Where to go for the full record: a permit id, work order id, incident id. Nullable
  /// because some events - a status change - have nothing further to show.
  refType String?
  refId   String?

  @@index([assetId, at])
}

enum AssetEventKind {
  created
  assigned
  inspection
  calibration
  maintenance
  incident
  status_change
  permit
}

// ─── Visitor management ──────────────────────────────────────────────────────

/// Somebody who is not staff and not a contractor worker, on site for a defined visit.
///
/// The register exists to answer one question at 3am with the alarm sounding: who is
/// inside the fence. Everything else here - approvals, acknowledgements, badges - is
/// machinery that keeps that answer true.
model Visitor {
  id   String @id @default(cuid())
  /// Human reference (VIS-####). Per tenant, same reasoning as Incident.number.
  code String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  name           String
  /// IC or passport. One column: which one it is varies by nationality and the register
  /// has to match on either when a blacklist is checked.
  idNumber       String
  nationality    String @default("")
  visitorCompany String @default("")
  phone          String @default("")
  email          String @default("")
  vehicleNumber  String @default("")

  /// The person responsible for them while they are on site. Named from the workforce
  /// register, not typed, so the approval can actually reach somebody.
  hostEmployeeId    String?
  hostEmployee      Employee?   @relation("VisitorHost", fields: [hostEmployeeId], references: [id], onDelete: SetNull)
  /// Kept as text as well: a host who leaves the company must not erase who signed them in.
  hostNameAtBooking String      @default("")
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  purpose String @default("")

  expectedArrival   DateTime
  expectedDeparture DateTime
  checkedInAt       DateTime?
  checkedOutAt      DateTime?

  status VisitorStatus @default(draft)

  /// Physical pass handed over at reception. Unique per site while it is out.
  badgeNumber     String?
  badgeIssuedAt   DateTime?
  badgeReturnedAt DateTime?

  /// Opaque payload printed on the pass. Separate from `code` so a pass can be reissued
  /// without renumbering the visit, and so a stale pass resolves to a clear 404.
  passKey String @unique

  notes String?

  emergencyContactName  String @default("")
  emergencyContactPhone String @default("")

  // Site rules. Each is a timestamp rather than a boolean: "when did they acknowledge the
  // emergency procedure" is the question asked after an evacuation, and a boolean cannot
  // answer it.
  inductionAt          DateTime?
  ndaAt                DateTime?
  safetyBriefingAt     DateTime?
  emergencyProcedureAt DateTime?
  siteRulesAt          DateTime?

  approvedBy   String?
  approvedAt   DateTime?
  rejectedBy   String?
  rejectedAt   DateTime?
  decisionNote String?

  deniedReason String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Optimistic concurrency, same as the other registers.
  version   Int      @default(0)

  events    VisitorEvent[]
  documents VisitorDocument[]

  incidentAppearances IncidentPerson[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, siteId, status])
  @@index([companyId, expectedArrival])
  @@index([hostEmployeeId])
  @@index([idNumber])
}

/// The visit lifecycle.
///
/// Appended in the order a visit actually moves so the enum reads as a process. Postgres
/// enums are append-only, so anything added later goes on the end regardless.
enum VisitorStatus {
  draft
  pre_registered
  waiting
  checked_in
  on_site
  checked_out
  expired
  denied
  blacklisted
  cancelled
}

/// One line of a visit's history. Written alongside the change that caused it.
model VisitorEvent {
  id        String  @id @default(cuid())
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  kind    VisitorEventKind
  /// One sentence, already written for a human. Rendered as-is.
  summary String
  detail  String?

  actor     String
  actorRole String   @default("")
  at        DateTime @default(now())

  @@index([visitorId, at])
}

enum VisitorEventKind {
  created
  approved
  rejected
  checked_in
  checked_out
  badge_issued
  badge_returned
  vehicle_added
  vehicle_removed
  blacklisted
  note_added
  acknowledgement
  status_change
}

/// A photo or signed document held against a visit.
///
/// Same storage contract as equipment documents and permit attachments.
model VisitorDocument {
  id        String  @id @default(cuid())
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  /// photo | id_scan | nda | other
  kind String @default("photo")

  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  uploadedBy   String
  uploadedById String

  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([visitorId, kind])
}

/// A person, company or vehicle refused entry.
///
/// Matched server-side at pre-registration and again at check-in, because a blacklist
/// checked only by the screen is not a blacklist. Kept as one table with a nullable
/// column per match type rather than a type/value pair, so a row cannot claim to be a
/// phone match and hold an IC number.
model VisitorBlacklist {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  idNumber       String?
  phone          String?
  visitorCompany String?
  vehicleNumber  String?

  reason    String
  /// Null means permanent. A date means it lapses on its own, which is what stops a
  /// blacklist becoming a list nobody dares prune.
  expiresAt DateTime?

  active   Boolean   @default(true)
  addedBy  String
  addedAt  DateTime  @default(now())
  liftedBy String?
  liftedAt DateTime?

  @@index([companyId, active])
  @@index([idNumber])
  @@index([phone])
  @@index([vehicleNumber])
}

/// Somebody involved in an incident: a witness, an injured person, or the person whose
/// act or omission is under investigation.
///
/// Named from a register where possible and kept as text regardless. A witness statement
/// has to survive the witness leaving the company, and an injured contractor may not be in
/// any register at all - which is exactly when the name matters most.
model IncidentPerson {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  role IncidentPersonRole

  /// At most one of these. Null on all three means somebody outside every register.
  employeeId         String?
  employee           Employee?         @relation("IncidentPeople", fields: [employeeId], references: [id], onDelete: SetNull)
  contractorWorkerId String?
  contractorWorker   ContractorWorker? @relation("IncidentPeople", fields: [contractorWorkerId], references: [id], onDelete: SetNull)
  visitorId          String?
  visitor            Visitor?          @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  /// Always written, even when a register row is linked. The record of who was named
  /// outlives them leaving.
  name    String
  company String @default("")

  /// Injury detail. Only meaningful for the injured role, nullable for everyone else.
  injuryType String?
  bodyPart   String?
  treatment  String?
  daysLost   Int?
  /// What they saw, in their words.
  statement  String?

  addedBy String
  addedAt DateTime @default(now())

  @@index([incidentId])
  @@index([incidentId, role])
  @@index([employeeId])
}

enum IncidentPersonRole {
  witness
  injured
  involved
  first_aider
}

/// A record elsewhere in the platform that this incident is about.
///
/// One table rather than four columns, because an incident routinely involves a permit and
/// an asset and a visitor at once, and because the interesting query is the reverse: what
/// has gone wrong around this permit, this contractor, this visitor.
///
/// Equipment keeps its own table (IncidentEquipment) - it was built first and carries an
/// involvement description this table has no place for.
model IncidentLink {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  kind        IncidentLinkKind
  /// The id of the linked row. Not a foreign key: it points at one of several tables, and
  /// a link that outlives a deleted permit is better than a cascade that erases the fact
  /// the incident referenced one.
  targetId    String
  /// Denormalised so the link renders without four joins, and still reads correctly after
  /// the target is renamed or removed.
  targetCode  String           @default("")
  targetLabel String           @default("")

  note String?

  addedBy String
  addedAt DateTime @default(now())

  @@unique([incidentId, kind, targetId])
  @@index([incidentId])
  @@index([kind, targetId])
}

enum IncidentLinkKind {
  permit
  employee
  contractor
  contractor_worker
  visitor
  asset
}

// ─── Scheduled reports ───────────────────────────────────────────────────────

/// A standing instruction to produce a report and send it to people.
///
/// The point of the module: an HSE manager should learn on Monday morning what is overdue
/// without logging in. Everything here is per tenant, and the recipients are user ids
/// checked against that tenant's memberships every time the schedule is written and again
/// when it runs - a stale recipient who has left the company must not keep receiving the
/// whole safety picture.
model ReportSchedule {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String
  reportType ReportType

  enabled Boolean @default(true)

  frequency ReportFrequency @default(weekly)
  /// 1 = Monday, 7 = Sunday (ISO). Only meaningful for the weekly frequency.
  dayOfWeek Int             @default(1)
  /// Local wall-clock time in `timezone`, as HH:mm. Stored as text because it is a time of
  /// day in somebody's week, not an instant.
  timeOfDay String          @default("08:00")
  /// IANA zone, stored explicitly. A server in UTC and a site in Kuching disagree by eight
  /// hours about when Monday morning is, and guessing is how a weekly report arrives on
  /// Sunday afternoon.
  timezone  String          @default("Asia/Kuching")

  /// User ids. Validated against this company's memberships on write and on send.
  recipientUserIds String[] @default([])

  /// Site scope, empty for the whole company.
  siteId    String?
  /// Project scope, empty for the whole company. Independent of siteId rather than nested
  /// under it: a schedule for a whole project is the common case, and one naming both is
  /// simply the narrower of the two.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  lastRunAt     DateTime?
  lastRunStatus String?
  lastRunError  String?
  /// The instant this is next owed, recomputed after every run. Indexed because the sweep
  /// asks "what is due" on every pass.
  nextRunAt     DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ReportRun[]

  @@index([companyId, enabled])
  @@index([enabled, nextRunAt])
}

enum ReportType {
  overdue_actions
  open_investigations
  /// A closed calendar month, rather than what is outstanding now.
  monthly_summary
  /// Every open corrective action, by department - the weekly SAIL for the HOD meeting.
  weekly_actions
  /// What happened on site in the last day or week: incidents, briefings, permits, actions.
  site_activity
}

enum ReportFrequency {
  daily
  weekly
  monthly
}

/// How far a run got with delivery.
enum ReportDeliveryStatus {
  /// The PDF exists. No provider is configured, so nothing was attempted.
  generated
  /// Being sent, or interrupted mid-send. A run left here after a crash is visible.
  email_pending
  /// A provider accepted it for at least one recipient.
  sent
  /// A provider was asked and refused.
  failed
}

/// One execution. Written before the work starts, so a crash mid-run leaves evidence.
model ReportRun {
  id         String          @id @default(cuid())
  scheduleId String?
  schedule   ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  reportType ReportType
  /// scheduled | manual - a Run now is recorded the same as an automatic pass.
  trigger    String     @default("scheduled")

  /// The period the report covered, so a re-read knows what it was about.
  periodStart DateTime?
  periodEnd   DateTime?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String    @default("running") // running | success | failed | delivered_partially

  rowCount       Int     @default(0)
  recipientCount Int     @default(0)
  /// Whether a provider actually accepted it. False when no mail provider is configured,
  /// which is recorded honestly rather than reported as sent.
  delivered      Boolean @default(false)
  deliveryNote   String?

  /// How far delivery got, separate from `status`, which is about generating the report.
  ///
  /// A report can generate perfectly and still fail to send, and the two outcomes need
  /// different responses: one is a bug, the other is a relay problem. Collapsing them into
  /// one column loses the PDF when only the email failed.
  deliveryStatus ReportDeliveryStatus @default(generated)
  /// The provider's own id for the message. The only thing that lets a support question -
  /// "did it actually go?" - be answered against the provider's dashboard.
  messageId      String?
  /// When the provider accepted it. Null until one does.
  sentAt         DateTime?
  /// Why it failed, in words. Never a credential, never a raw provider payload.
  failureReason  String?
  /// Which provider handled it: resend | smtp | none
  provider       String?

  /// How many times delivery has been attempted. Bounded; see MAX_ATTEMPTS.
  attempts        Int       @default(0)
  lastAttemptAt   DateTime?
  /// When the next attempt becomes due. Null means no retry is owed - either it succeeded,
  /// or it failed permanently, or the attempts ran out.
  nextAttemptAt   DateTime?
  /// The exact email this run produced: subject, bodies and resolved recipients. A retry
  /// re-sends this, so the message that arrives always matches the stored PDF.
  deliveryPayload Json?

  /// The stored PDF, same contract as every other file in the platform.
  storedName   String?
  originalName String?
  sizeBytes    Int?

  error String?

  triggeredBy String

  /// One run per schedule per due slot.
  ///
  /// The sweep runs every fifteen minutes and can be started more than once; without this
  /// a Monday report goes out four times before nine o'clock. Null for manual runs, which
  /// are deliberate and may be repeated.
  dueSlot String?

  @@unique([scheduleId, dueSlot])
  @@index([companyId, startedAt])
  @@index([scheduleId, startedAt])
  /// The recovery sweep asks "what delivery is owed" on every pass.
  @@index([deliveryStatus, nextAttemptAt])
}

/// An invitation to join one workspace.
///
/// The User row is created immediately so the account shows as Invited in the console and
/// its role and site assignment are settled before anyone clicks anything. What this adds
/// is the missing piece: a single-use, time-limited secret that lets the invitee set a
/// password. Only the hash is stored, exactly as password resets do - a leaked database
/// must not hand out working invitations.
model Invitation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email        String
  role         Role
  /// Where the invitee lands. Validated against this tenant when the invitation is issued.
  siteIds      String[] @default([])
  departmentId String?

  /// sha256 of the token that was handed out. The token itself is never stored.
  tokenHash String   @unique
  expiresAt DateTime

  /// Terminal states. Both nullable, so an open invitation is simply neither.
  acceptedAt DateTime?
  revokedAt  DateTime?
  revokedBy  String?

  /// The account this invitation belongs to, so accepting activates the right user.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Whether this invitation created the account, or merely adds an existing person to a
  /// second workspace.
  ///
  /// Load-bearing, not bookkeeping. Accepting an invitation sets a password, which is the
  /// right thing to do for an account that has never had one and a cross-tenant account
  /// takeover for one that has: `User.email` is globally unique, so an administrator of one
  /// workspace can invite an address belonging to a user of another, and before this flag
  /// existed acceptance overwrote that person's real password. Defaults to false so any row
  /// written before this column existed is treated as the dangerous case.
  provisionedUser Boolean @default(false)

  invitedBy String
  createdAt DateTime @default(now())

  /// Delivery, in the same vocabulary ReportRun already uses: created, email_pending,
  /// sent, failed. Deliberately the same words rather than a second scheme - an operator
  /// who has learnt what "failed" means on the Reports page should not learn it twice.
  ///
  /// The invitation stays usable whatever this says. A provider outage must not cost
  /// somebody their way into the workspace; it costs them an email, and the link can be
  /// resent or passed on by hand.
  deliveryStatus String    @default("created")
  /// The provider's own id, for answering "did it actually go?" from their dashboard.
  messageId      String?
  sentAt         DateTime?
  failureReason  String?
  /// resend | smtp. Never anything about how it authenticates.
  provider       String?
  /// Sends attempted, including resends. Also what makes each send's idempotency key
  /// distinct, so a resend is a new email while a retry of one send is not.
  attempts       Int       @default(0)
  lastAttemptAt  DateTime?

  @@index([companyId, email])
  @@index([companyId, createdAt])
  @@index([userId])
}

/// The daily toolbox meeting for a whole site.
///
/// Distinct from the toolbox talk on a permit, which briefs the named crew of one job. This
/// is the mass pre-shift meeting - on a multi-contractor site, hundreds of people from
/// several firms at once - so attendance is a headcount per organisation rather than a
/// list of names nobody could type. The site safety officer records it; the register is
/// what an auditor or a client asks for when they want proof the briefing happened.
model ToolboxMeeting {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id])

  /// TBM-#### per tenant, quoted when the register is handed to a client.
  number String

  heldAt  DateTime
  ledBy   String
  topic   String
  /// What was said about today's work: the hazards, the controls, the lessons shared.
  hazards String   @default("")
  notes   String   @default("")

  /// Sum of the groups, stored so the register and the reports count without a join.
  headcount Int @default(0)

  recordedBy   String
  recordedById String

  groups ToolboxAttendanceGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId, heldAt])
  @@index([siteId, heldAt])
}

/// Who was there, as a headcount per organisation: the tenant's own staff, each contractor.
model ToolboxAttendanceGroup {
  id           String         @id @default(cuid())
  meetingId    String
  meeting      ToolboxMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  organisation String
  count        Int

  @@index([meetingId])
}

/// When each background job last ran, and how it went.
///
/// Written by whichever process runs the scheduler - the worker in production - so every
/// API replica reports the same thing on System Health. It used to live in the memory of
/// the process that ran the job, which a separate worker (or a second replica holding no
/// lock) could not see.
model JobRun {
  /// The job's key, e.g. "reminders" - see JOBS in src/lib/jobRuns.ts.
  job            String    @id
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastOk         Boolean   @default(true)
  /// The first line of the last failure, for the operator. Never a stack or a payload.
  lastError      String?
  lastDurationMs Int?
  /// Which process ran it (hostname:pid), so two workers are distinguishable in the log.
  instance       String?
  runCount       Int       @default(0)
  failureCount   Int       @default(0)
  updatedAt      DateTime  @updatedAt
}

/// Hours worked at a site in one calendar month - the denominator of every injury rate.
///
/// DOSH's JKKP 8 annual return, and every frequency or severity rate an HSE manager reports,
/// divide by man-hours worked: lost-time injuries x 1,000,000 / hours. SafeChain had no record
/// of hours at all, so it could count injuries but never say whether a site's rate was rising
/// or falling as its workforce changed. One row per site per month, entered by the people who
/// hold the timesheets; months without a row are estimated from headcount and labelled so.
model SiteManHours {
  id        String   @id @default(cuid())
  companyId String
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// The first day of the month, UTC midnight.
  month     DateTime
  /// Total hours worked on site that month: employees and contractors.
  hours     Int
  updatedBy String
  updatedAt DateTime @updatedAt

  @@unique([siteId, month])
  @@index([companyId, month])
}

/// A company's target for one HSE performance indicator, e.g. LTI frequency rate ≤ 0.5.
/// Which way "on target" points (at most / at least) is fixed per metric in code
/// (TARGET_METRICS in lib/hsePerformance.ts), so a row cannot hold a backwards target.
model PerformanceTarget {
  id        String   @id @default(cuid())
  companyId String
  /// One of TARGET_METRICS.
  metric    String
  /// In the indicator's own unit; onTimeClosure is a fraction 0..1.
  value     Float
  updatedBy String
  updatedAt DateTime @updatedAt

  @@unique([companyId, metric])
}

/// A photo or document taken in the field and kept against an inspection, an audit answer
/// or a corrective action that has no incident.
///
/// Those three had no storage at all: the inspection and audit runners counted the photos
/// chosen and discarded them, and an action raised outside an investigation could take no
/// file, so one marked "evidence required" could never be completed. Incident evidence and
/// permit documents keep their own tables; this holds what had nowhere to go.
///
/// Exactly one parent per row, enforced by a CHECK constraint in the migration, so a
/// photo can neither be orphaned nor claimed by two records. Each parent is a real foreign
/// key that cascades, unlike a polymorphic id-and-type pair. companyId is denormalised
/// from the parent so row-level security covers the table directly.
model FieldEvidence {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inspectionId String?
  inspection   Inspection?       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  auditId      String?
  audit        Audit?            @relation(fields: [auditId], references: [id], onDelete: Cascade)
  /// The checklist item an audit photo shows. Only with auditId.
  auditItemId  String?
  actionId     String?
  action       CorrectiveAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)

  originalName String
  storedName   String  @unique
  mimeType     String
  sizeBytes    Int
  /// SHA-256 of the bytes as written. Required from the start, unlike the older tables.
  checksum     String
  uploadedBy   String
  uploadedById String?

  createdAt DateTime @default(now())

  @@index([inspectionId])
  @@index([auditId, auditItemId])
  @@index([actionId])
  @@index([companyId, createdAt])
}
