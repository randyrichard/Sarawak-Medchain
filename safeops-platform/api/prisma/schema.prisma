// SafeOps API — authentication & authorization data model.
// Security notes:
//  - `passwordHash` stores an Argon2id digest. Plaintext passwords are never persisted or logged.
//  - Refresh tokens are stored as SHA-256 hashes, never in cleartext, so a database leak does not
//    hand an attacker usable sessions.
//  - Lockout state lives here (server-side) so it cannot be cleared by the client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ceo
  admin
  hse_manager
  safety_officer
  supervisor
  employee
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  title        String?
  /// Argon2id digest — never a plaintext or reversible value.
  passwordHash String
  status       String  @default("active") // active | invited | deactivated | locked

  // ── Brute-force protection (server-authoritative) ──
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  mustChangePassword Boolean @default(false)
  mfaEnabled         Boolean @default(false)
  /// Shown in the admin console's user list. Additive and nullable — authentication
  /// does not read it, so every existing account is unaffected.
  department         String?

  /// Per-user settings that should follow the person between devices:
  /// { landingPage?: string, defaultSiteId?: string | null }.
  ///
  /// Stored as JSON rather than columns because these are read and written whole, by one
  /// screen, and a new preference should not need a migration. Theme is deliberately NOT
  /// here — it belongs to the device, and round-tripping it through the server would make
  /// a dark-mode toggle wait on the network. Nullable, so every existing account keeps
  /// the defaults without a backfill.
  preferences        Json?

  memberships   Membership[]
  refreshTokens RefreshToken[]
  loginAttempts LoginAttempt[]
  resetTokens   PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// A user's role within a company. Authorization is derived from these rows on the
/// server — never from anything the client sends.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role
  siteIds   String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
}

/// A single-use password reset issued by an administrator.
///
/// Only the SHA-256 digest is stored, the same rule the refresh tokens follow: the raw
/// value exists once, in the link handed to the user, and a database dump yields nothing
/// an attacker can redeem. `usedAt` makes redemption single-use, and short expiry bounds
/// how long a link left in a chat thread stays dangerous.
model PasswordResetToken {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  /// Who issued it — a reset is an account takeover if misused, so it is attributable.
  issuedBy  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

/// One row per issued refresh token. Rotation replaces the row and links the successor,
/// so replaying a consumed token is detectable (see `revokedReason = "reuse_detected"`).
model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  /// SHA-256 of the opaque token. The raw value exists only in the client's cookie.
  tokenHash String @unique
  /// Groups every token rotated from one login, so a whole session can be revoked at once.
  familyId  String

  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  replacedById  String?

  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

/// Immutable security event log for authentication. Append-only by convention in Phase 1;
/// hash-chained for tamper evidence in Phase 3.
model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  outcome   String // success | bad_password | unknown_user | locked_out | deactivated
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
}

// ─── Organisation ────────────────────────────────────────────────────────────
// Incidents are scoped by company and site, and RBAC narrows visibility by site,
// so both must be real rows with foreign keys rather than client-side constants.

model Company {
  id        String     @id
  name      String
  plan      String     @default("enterprise")
  /// Shown in the company switcher. Additive: every existing row keeps a sensible
  /// default and nothing that reads Company today is affected.
  industry     String @default("")
  logoInitials String @default("")
  sites       Site[]
  incidents   Incident[]
  actions     CorrectiveAction[]
  permits     Permit[]
  assets      Asset[]
  inspections Inspection[]
  audits      Audit[]
  auditTemplates AuditTemplate[]
  obligations    ComplianceObligation[]
  documents      ComplianceDocument[]
  employees      Employee[]
  ppeIssues      PpeIssue[]
  contractors    ContractorCompany[]
  contractorWorkers ContractorWorker[]
  courses        TrainingCourse[]
  sessions       TrainingSession[]
  certificates   Certificate[]
  roleDefs       RoleDefinition[]
  adminAudit     AdminAuditEntry[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  connectors     ConnectorConfig[]
  securityPolicy SecurityPolicy?
  orgSettings    OrgSettings?
  configItems    OrgConfigItem[]
  retention      RetentionPolicy?
  backups        Backup[]
  notifications  Notification[]
  createdAt   DateTime   @default(now())
  visitors          Visitor[]
  visitorBlacklist  VisitorBlacklist[]
}

model Site {
  id        String     @id
  companyId String
  name      String
  /// Display fields for the organisation tree. Additive, with defaults.
  short     String  @default("")
  city      String  @default("")
  timezone  String  @default("Asia/Kuching")
  headcount Int     @default(0)
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  incidents   Incident[]
  actions     CorrectiveAction[]
  permits     Permit[]
  assets      Asset[]
  inspections Inspection[]
  audits      Audit[]
  obligations ComplianceObligation[]
  documents   ComplianceDocument[]
  employees   Employee[]
  contractorWorkers ContractorWorker[]
  sessions    TrainingSession[]
  departments Department[]

  @@index([companyId])
  visitors Visitor[]
}

/// A department within a site. Employees carry the resolved department name for course
/// applicability; this is the structure the organisation tree renders and the place a
/// rename belongs.
model Department {
  id     String @id
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name  String
  teams Team[]

  createdAt DateTime @default(now())

  @@index([siteId])
  visitors Visitor[]
}

model Team {
  id           String     @id
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  name String
  lead String @default("")

  createdAt DateTime @default(now())

  @@index([departmentId])
}

// ─── Incidents ───────────────────────────────────────────────────────────────

enum IncidentType {
  near_miss
  first_aid
  mtc
  rwc
  lti
  fatality
  property_damage
  environmental
  vehicle
  fire
  unsafe_act
  unsafe_condition
}

enum IncidentSeverity {
  Minor
  Moderate
  Serious
  Critical
}

/// Investigation workflow. Ordered; transitions are validated server-side.
enum IncidentStage {
  reported
  assessment
  investigation
  rca
  actions
  review
  verification
  closed
}

model Incident {
  id     String @id @default(cuid())
  /// Human reference (INC-####). Unique per tenant, not globally: two companies each
  /// run their own sequence and both legitimately have an INC-2601.
  number String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  title       String
  description String           @default("")
  type        IncidentType
  severity    IncidentSeverity
  stage       IncidentStage    @default(reported)

  department       String  @default("")
  location         String
  gps              String?
  immediateActions String  @default("")

  reporter     String
  reporterId   String?
  investigator String?

  /// Set during assessment; drives the high-risk flag on Mission Control.
  riskRating        String?
  potentialSeverity IncidentSeverity?
  highRisk          Boolean           @default(false)

  findings  String?
  closeNote String?

  /// Contributing causes: [{ id, category, description }]
  rcaCauses     Json?
  /// Five Whys: { problem, whys: string[], rootStatement }
  rcaFiveWhys   Json?
  rcaApprovedBy String?
  rcaApprovedAt DateTime?

  occurredAt DateTime
  reportedAt DateTime  @default(now())
  closedAt   DateTime?

  archived Boolean @default(false)
  /// Incremented on every mutation — lets the client detect a stale write.
  version  Int     @default(1)

  events      IncidentEvent[]
  comments    IncidentComment[]
  attachments IncidentAttachment[]
  actions     CorrectiveAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite indexes matching the actual list queries (company+stage, company+site).
  equipmentLinks IncidentEquipment[]

  @@unique([companyId, number])
  @@index([companyId, stage])
  @@index([companyId, siteId])
  @@index([companyId, type])
  @@index([reportedAt])
}

/// Append-only audit trail for an incident. Never updated or deleted.
model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  action    String
  detail    String?
  actor     String
  actorRole String?
  at        DateTime @default(now())

  @@index([incidentId, at])
}

/// Server-owned counter for human-readable references. A row per company keeps
/// INC numbering per-tenant and lets allocation happen inside a transaction, so
/// two simultaneous reports cannot receive the same number.
model Counter {
  companyId String
  /// Sequence name within the tenant: "incident", "capa", ...
  kind      String
  next      Int    @default(1)

  // Composite primary key. A single-column @id would make the sequence name globally
  // unique, so the first tenant to allocate "incident" would lock out every other one.
  @@id([companyId, kind])
}

// ─── Incident collaboration & corrective actions ─────────────────────────────

model IncidentComment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  body      String
  author    String
  authorId  String?
  /// Names mentioned with @ — drives notification fan-out.
  mentions  String[] @default([])
  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
}

model IncidentAttachment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  /// Original client filename, retained for display only — never used as a path.
  originalName String
  /// Server-generated name actually written to disk. Prevents path traversal and collisions.
  storedName   String  @unique
  mimeType     String
  sizeBytes    Int
  uploadedBy   String
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([incidentId])
}

model CapaNote {
  id       String           @id @default(cuid())
  actionId String
  action   CorrectiveAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  body      String
  author    String
  authorId  String?
  mentions  String[] @default([])
  createdAt DateTime @default(now())

  @@index([actionId, createdAt])
}

enum CapaSource {
  incident
  audit
  inspection
  manual
  training
}

enum CapaStatus {
  open
  in_progress
  completed
  verified
  cancelled
}

enum CapaPriority {
  Low
  Medium
  High
  Critical
}

/// Corrective and preventive action. The SAIL replacement: every item has an owner
/// and a target completion date, and closure requires verification by a manager.
model CorrectiveAction {
  id         String   @id @default(cuid())
  /// CA-#### — per tenant, same reasoning as Incident.number.
  code String
  /// Null for actions raised outside an investigation — an audit finding, an inspection
  /// failure, or a manual entry. The Actions register (SAIL) is the union of both, so
  /// this must be optional or those items have nowhere to live.
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  /// Where the action came from, for filtering and reporting.
  source     CapaSource @default(incident)

  // Real foreign keys, not bare strings. Without them a standalone action (incidentId
  // null) has no cascade path, so deleting a tenant orphans its safety records, and
  // nothing stops an action being written against a company that does not exist.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  title    String
  detail   String       @default("")
  owner    String
  ownerId  String?
  dueDate  DateTime
  priority CapaPriority @default(Medium)
  status   CapaStatus   @default(open)

  /// Evidence the owner supplies when marking complete.
  evidenceNote String?
  completedAt  DateTime?

  /// Verification is a separate act by a manager — completing is not closing.
  verifiedBy String?
  verifiedAt DateTime?

  cancelledReason String?

  /// Set when an inspection failure raised this action. Both are additive and nullable:
  /// every existing action keeps `null` and behaves exactly as before. They exist because
  /// an asset's open-defect count and an inspection's action list are two different
  /// questions, and deriving either one from the other loses rows.
  assetId      String?
  asset        Asset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  /// Back-reference only — the foreign key lives on AuditFinding, so this adds no column
  /// to CorrectiveAction and every existing action is unaffected.
  finding AuditFinding?

  notes CapaNote[]

  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  // Restored, not added: the standalone_actions migration created this index and a later
  // schema edit dropped the declaration without a migration. The register filters by
  // source, so leaving the drift in place makes the next `migrate dev` delete a live index.
  @@index([companyId, source])
  @@index([incidentId])
  @@index([dueDate])
  @@index([owner])
  @@index([assetId])
  @@index([inspectionId])
}

// ─── Permit to Work ──────────────────────────────────────────────────────────
// A permit authorises high-risk work for a bounded window. Every gate that makes it a
// control rather than a form — confirmed precautions, a passing gas test, released
// isolations, a handback signature — is enforced in permitService, not in the client.

enum PermitType {
  hot_work
  confined_space
  working_at_height
  electrical_isolation
  excavation
  lifting_operation
  line_breaking
  radiography
  // Added later. Enum values are append-only in Postgres, so the original eight keep
  // their positions and no existing permit changes meaning.
  loto
  cold_work
  pressure_testing
  vehicle_entry
}

/// Stored lifecycle states only.
///
/// `expired` is deliberately absent: it is not a state anyone writes, it is what an
/// approved or active permit *becomes* once the clock passes `validTo`. Storing it would
/// need a job to keep the column true, and any window where that job had not run would
/// report expired work as live — exactly the failure the permit exists to prevent.
/// The service derives it on read instead, so it is correct the instant it happens.
enum PermitStatus {
  draft
  submitted
  approved
  active
  suspended
  closed
  rejected
  /// The approval chain between submission and approval. A permit sits with the
  /// supervisor, then HSE, then the area authority who actually owns the plant.
  supervisor_review
  hse_review
  area_authority
  /// Archived: closed and filed. Excluded from every live view, kept for the record.
  archived
}

enum PermitSignatureRole {
  applicant
  approver
  closer
}

model Permit {
  id String @id @default(cuid())
  /// Human reference (PTW-####). Per tenant, same reasoning as Incident.number.
  code String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  type        PermitType
  title       String
  description String     @default("")
  department  String     @default("")
  location    String

  applicant   String
  /// Legacy free-text contractor name. Superseded by contractorCompanyId; retained so
  /// permits raised before the contractor register existed still read correctly.
  contractor  String?
  /// The engaged firm. Validated at assignment: a suspended contractor cannot be named.
  contractorCompanyId String?
  contractorCompany   ContractorCompany? @relation(fields: [contractorCompanyId], references: [id], onDelete: SetNull)
  workerCount Int    @default(1)

  /// Pre-start briefing. A permit issued without one is the single most common finding
  /// in a post-incident review, so it is recorded rather than assumed.
  toolboxAt DateTime?
  toolboxBy String?

  /// Job safety analysis / risk assessment reference and sign-off.
  jsaReference String?
  jsaConfirmed Boolean @default(false)

  /// PPE the issuer requires for this job, beyond site-standard.
  requiredPpe String[] @default([])

  /// Mandatory PPE acknowledged by the issuer at activation. Recorded rather than
  /// assumed: "the harness was on the list" and "the harness was checked" differ.
  ppeAcknowledgedAt DateTime?
  ppeAcknowledgedBy String?

  attendees   PermitAttendee[]
  extensions  PermitExtension[]
  equipment   PermitEquipment[]
  jsaSteps    PermitJsaStep[]
  attachments PermitAttachment[]

  /// Authorised window. The permit is only a permit between these two instants; the
  /// maximum span allowed depends on the type (see PERMIT_MAX_HOURS).
  validFrom DateTime
  validTo   DateTime

  status PermitStatus @default(draft)

  approver        String?
  approvedAt      DateTime?
  rejectionReason String?
  suspendedReason String?

  closedBy String?
  closedAt DateTime?
  /// Site handed back clean, tools removed, isolations released.
  handbackConfirmed Boolean @default(false)

  /// Set when an incident occurred under this permit.
  linkedIncidentId String?

  controls   PermitControl[]
  isolations IsolationPoint[]
  gasTests   GasTest[]
  signatures PermitSignature[]
  timeline   PermitEvent[]

  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, siteId])
  @@index([companyId, type])
  // The board is ordered by urgency and the expiry sweep asks "what lapses next",
  // so validTo is the column both hot paths sort and filter on.
  @@index([validTo])
}

/// A precaution the issuer confirms on site. Required ones block issue until confirmed.
model PermitControl {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  /// Checklist order for the type. Rows would otherwise come back unordered, and a
  /// precaution list that reshuffles between reads is not one anyone can work down.
  position Int
  label    String
  required Boolean @default(true)

  confirmed   Boolean   @default(false)
  confirmedBy String?
  confirmedAt DateTime?
  note        String?

  @@index([permitId, position])
}

/// An energy source locked out and tagged. A permit cannot close while one is still applied.
model IsolationPoint {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  description String
  /// The physical lock/tag identifier, e.g. "LOTO-4471".
  tagId       String
  isolatedBy  String?
  isolatedAt  DateTime?
  removedBy   String?
  removedAt   DateTime?

  @@index([permitId])
}

/// Atmospheric readings. `pass` is computed server-side from GAS_LIMITS and stored, so
/// the verdict a permit was issued on stays readable even if the limits are later revised.
model GasTest {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  testedAt DateTime @default(now())
  testedBy String

  oxygenPct Float
  lelPct    Float
  h2sPpm    Float
  coPpm     Float
  pass      Boolean
  note      String?

  @@index([permitId, testedAt])
}

/// Who signed what, and the statement they signed. Append-only.
model PermitSignature {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  role      PermitSignatureRole
  name      String
  signedAt  DateTime            @default(now())
  statement String

  @@index([permitId, signedAt])
}

/// Append-only audit trail for a permit. Never updated or deleted.
model PermitEvent {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  action    String
  detail    String?
  actor     String
  actorRole String?
  at        DateTime @default(now())

  @@index([permitId, at])
}

// ─── Assets & Inspections ────────────────────────────────────────────────────
// Assets are inspected on a schedule. A failed checklist item is not a note — it
// becomes a corrective action with an owner and a due date, because a defect nobody
// is accountable for is a defect that stays on the plant.

enum AssetCategory {
  fire_extinguisher
  forklift
  ladder
  scaffolding
  machinery
  electrical_panel
  emergency_lighting
  first_aid_kit
  ppe
  vehicle
  pressure_vessel
  crane
  chain_block
  lifting_sling
  harness
  gas_detector
  scba
  pressure_gauge
  electrical_tool
  generator
  compressor
  custom
}

enum AssetStatus {
  in_service
  under_maintenance
  out_of_service
  retired
  /// In active use on a job. Distinct from in_service so a shared gas detector cannot be
  /// booked onto two permits at once.
  in_use
  /// Written off. Kept separate from retired so a disposal is auditable as a disposal.
  disposed
}

enum InspectionFrequency {
  daily
  weekly
  monthly
  quarterly
  annual
}

enum InspectionStatus {
  scheduled
  completed
  cancelled
}

enum InspectionOutcome {
  passed
  failed
}

model Asset {
  id String @id @default(cuid())
  /// Human reference (AST-####). Per tenant, same reasoning as Incident.number.
  code String
  /// Payload printed on the QR label. Separate from `code` so a label can be reissued
  /// without renumbering the asset, and so a stale label resolves to a clear 404.
  qrKey String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  name           String
  category       AssetCategory
  customCategory String?
  serialNumber   String
  manufacturer   String        @default("")
  model          String        @default("")

  purchaseDate   DateTime?
  commissionDate DateTime?
  warrantyUntil  DateTime?

  department String @default("")
  owner      String
  location   String @default("")

  status    AssetStatus         @default(in_service)
  frequency InspectionFrequency

  /// Safety-critical: failure of this item hurts someone directly. Drives the register's
  /// filters, the dashboard, and how loudly the reminder engine chases it.
  critical Boolean @default(false)

  /// Who currently holds it. Exactly one of these, or neither for pool equipment.
  assignedEmployeeId String?
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedContractorWorkerId String?
  assignedContractorWorker   ContractorWorker? @relation(fields: [assignedContractorWorkerId], references: [id], onDelete: SetNull)

  notes String?

  /// Calibration applies to measuring instruments only. Null on everything else, which is
  /// how the permit gate knows whether to demand a valid certificate.
  requiresCalibration Boolean @default(false)

  calibrations Calibration[]
  permitUsages PermitEquipment[]
  workOrders   WorkOrder[]
  incidentLinks IncidentEquipment[]
  events       AssetEvent[]

  lastInspectedAt DateTime?
  /// Date the next inspection falls due. Rolled forward on completion so an asset can
  /// never drop off the calendar by being inspected.
  nextDueDate     DateTime

  documents   AssetDocument[]
  inspections Inspection[]
  actions     CorrectiveAction[]

  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, qrKey])
  @@index([companyId, status])
  @@index([companyId, siteId])
  @@index([companyId, category])
  // The register sorts and filters on what is due, so this is the hot path.
  @@index([nextDueDate])
}

/// A file held against a piece of equipment: photos, manuals, certificates.
///
/// Same storage contract as permit documents and incident evidence - one way of handling
/// uploaded files in this codebase, not three. The file columns are nullable because rows
/// predating real storage exist; those render as a name with no download rather than a
/// broken link.
model AssetDocument {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  name String
  /// photo | manual | certificate | pdf | image
  kind String @default("pdf")

  /// The name the operator's device gave it. Shown, never used as a path.
  originalName String?
  /// A UUID chosen by the server. The only name that touches the filesystem.
  storedName   String?
  mimeType     String?
  sizeBytes    Int?
  uploadedBy   String?
  uploadedById String?

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([assetId, kind])
}

model Inspection {
  id String @id @default(cuid())
  /// Human reference (INS-####). Per tenant.
  code String

  assetId   String
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  scheduledFor DateTime
  assignedTo   String
  status       InspectionStatus @default(scheduled)

  completedAt DateTime?
  completedBy String?
  outcome     InspectionOutcome?

  /// The completed checklist: [{ itemId, label, result, comment?, measurement? }].
  /// Stored whole because it is written once at completion and always read as a unit —
  /// it is the record of what was checked, not a table anyone queries across.
  answers Json?

  comments   String?
  photoCount Int     @default(0)
  gps        String?
  signature  String?

  /// Defects raised from this inspection.
  actions CorrectiveAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([assetId, scheduledFor])
  @@index([scheduledFor])
}

// ─── Audits & Compliance ─────────────────────────────────────────────────────
// An audit runs a checklist template. A failed item becomes a finding, and every
// finding raises a corrective action with an owner and a date. The audit cannot close
// until each of those actions is verified — that is what makes the register evidence
// rather than a report, and it is enforced in auditService, not in the client.

enum AuditType {
  internal
  external
  dosh
  iso45001
  customer
  contractor
  supplier
  environmental
  quality
  custom
}

enum AuditStatus {
  planned
  in_progress
  completed
  closed
}

enum AuditPriority {
  High
  Medium
  Low
}

enum FindingSeverity {
  Critical
  Major
  Minor
  Observation
}

enum DocKind {
  policy
  sop
  certificate
  inspection_report
  permit
  training_record
  audit_report
}

enum DocStatus {
  Draft
  PendingApproval
  Approved
  Superseded
}

/// A tenant-authored checklist. The built-in templates live in auditCatalog.ts and are
/// available to everyone; only custom ones are rows, which is why companyId is required
/// here — a template someone wrote belongs to the workspace that wrote it.
model AuditTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  type AuditType @default(custom)
  /// [{ title, items: [{ id, text, guidance? }] }]
  sections Json

  createdBy String
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Audit {
  id String @id @default(cuid())
  /// Human reference (AUD-####). Per tenant.
  code String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  title      String
  type       AuditType
  customType String?
  department String   @default("")

  leadAuditor String
  team        String[] @default([])
  /// Either a built-in catalogue id or an AuditTemplate row id. Not a foreign key
  /// because the built-ins are not rows; the service resolves both.
  templateId  String

  scheduledFor DateTime
  durationDays Int           @default(1)
  priority     AuditPriority @default(Medium)
  status       AuditStatus   @default(planned)

  startedAt   DateTime?
  completedAt DateTime?
  closedAt    DateTime?

  /// Percentage of applicable items that passed. N/A answers are excluded, so a
  /// checklist half of which does not apply is not scored as half-failed.
  score     Int?
  /// [{ itemId, section, text, result, comment?, photoCount? }]
  answers   Json?
  signature String?
  gps       String?

  findings AuditFinding[]
  timeline AuditEvent[]

  version   Int      @default(1)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, siteId])
  @@index([companyId, type])
  @@index([scheduledFor])
}

model AuditFinding {
  id String @id @default(cuid())
  /// Human reference (F-####). Per tenant.
  code String

  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  /// The checklist section the failure came from.
  category    String
  description String
  severity    FindingSeverity

  evidenceNote     String?
  photoCount       Int     @default(0)
  linkedAssetId    String?
  linkedIncidentId String?

  /// The corrective action raised for this finding. One-to-one: a finding without an
  /// owned action is a note, and the audit cannot close on notes.
  actionId String           @unique
  action   CorrectiveAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  raisedBy String
  raisedAt DateTime @default(now())

  @@index([auditId])
}

/// Append-only audit trail for an audit. Never updated or deleted.
model AuditEvent {
  id      String @id @default(cuid())
  auditId String
  audit   Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  action    String
  detail    String?
  actor     String
  actorRole String?
  at        DateTime @default(now())

  @@index([auditId, at])
}

/// A statutory or contractual obligation with a renewal date. Status is derived from
/// nextDue on read, for the same reason permit expiry is.
model ComplianceObligation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Null means organisation-wide rather than tied to one site.
  siteId    String?
  site      Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  regulation  String
  requirement String
  responsible String

  nextDue       DateTime
  expiryDate    DateTime?
  evidenceDoc   String?
  notes         String?
  lastRenewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, nextDue])
}

model ComplianceDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name    String
  kind    DocKind
  version String    @default("1.0")
  status  DocStatus @default(PendingApproval)
  owner   String
  sizeKb  Int       @default(0)

  approvedBy String?
  approvedAt DateTime?

  versions DocumentVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, kind])
}

/// One row per uploaded revision. Append-only: superseding a version records a new row
/// rather than overwriting, so the approval history of a controlled document survives.
model DocumentVersion {
  id         String             @id @default(cuid())
  documentId String
  document   ComplianceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  version String
  note    String @default("")
  by      String
  at      DateTime @default(now())

  @@index([documentId, at])
}

// ─── Training & Competency ───────────────────────────────────────────────────
// Courses define what competency looks like; sessions deliver it; certificates carry
// an expiry. The matrix and every compliance figure are derived from certificates on
// read — a stored "competent" flag is a flag that is wrong the day a cert lapses.

enum CourseCategory {
  induction
  safety
  equipment
  emergency
  health
  environmental
  custom
}

enum DeliveryMode {
  online
  physical
}

enum SessionStatus {
  scheduled
  completed
  cancelled
}

enum AttendanceResult {
  pass
  fail
}

/// The workforce. Training hangs off real people, so this is a table rather than a
/// client-side fixture. Departments arrive with the organisation migration; until then
/// the resolved department name is carried here, which is what course applicability
/// actually matches on.
model Employee {
  id        String  @id @default(cuid())
  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// Retained for the organisation migration; not yet a foreign key.
  departmentId String?
  department   String  @default("")
  teamId       String?

  /// EMP-#### per company. People are referred to by this on permits, toolbox talks and
  /// medical records, so it has to be stable and quotable rather than an internal id.
  employeeNo String @default("")

  name     String
  position String  @default("")
  email    String?
  phone    String?
  active   Boolean @default(true)

  hireDate DateTime?

  /// Fitness-to-work certificate expiry. This is the field that stops someone being
  /// allowed on a job: an expired medical is a legal bar on confined space, working at
  /// height and most hot work, so it is queried and reminded on, not filed away.
  medicalExpiry DateTime?
  bloodGroup    String?
  /// Restrictions a supervisor must know about — "no working at height", "wears glasses".
  medicalNotes  String?

  enrolments        SessionEnrolment[]
  certificates      Certificate[]
  permitAttendances PermitAttendee[]
  assignedAssets    Asset[]
  emergencyContacts EmergencyContact[]
  ppeIssues         PpeIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, employeeNo])
  @@index([companyId])
  @@index([companyId, siteId])
  @@index([name])
  @@index([companyId, medicalExpiry])
  visitorsHosted Visitor[] @relation("VisitorHost")
}

/// Who to call when someone is hurt. A separate table rather than two columns because
/// the real answer is often "spouse, and the site clinic", and a next-of-kin list that
/// only holds one name is the sort of gap nobody notices until the day it matters.
model EmergencyContact {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  name         String
  relationship String @default("")
  phone        String
  altPhone     String?
  /// The one to ring first. Exactly one per employee is kept primary by the service.
  isPrimary    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

/// Personal protective equipment issued to a person.
///
/// Tracked per issue rather than as a checkbox on the employee because the auditable
/// question is "when was this harness last replaced and who signed for it", and because
/// a replacement is a new issue, not an edit of the old one.
model PpeIssue {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  item String
  size String @default("")
  /// Serial or asset tag where the item carries one — harnesses and respirators do.
  serialNumber String?

  issuedAt   DateTime  @default(now())
  issuedBy   String
  /// When it is due for replacement. Null for items with no service life.
  replaceDue DateTime?
  returnedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([companyId, replaceDue])
}

/// What someone is on a permit to do.
enum PermitAttendeeRole {
  /// Named in charge of the work on the ground.
  supervisor
  /// Accepts the permit from the issuer.
  receiver
  /// Doing the work.
  worker
  /// Watches the entry point on a confined space. Never counted as inside.
  standby
  gas_tester
}

/// A person named on a permit.
///
/// Exactly one of employeeId or contractorWorkerId is set — the permit does not care
/// whose payroll someone is on, but the register they came from decides which fitness
/// rules apply. Names are never free text here: a typo used to mean an unfit person
/// could be written onto a hot work permit and nothing would notice.
model PermitAttendee {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  contractorWorkerId String?
  contractorWorker   ContractorWorker? @relation(fields: [contractorWorkerId], references: [id], onDelete: Restrict)

  role PermitAttendeeRole @default(worker)

  /// Snapshot of the name at assignment, so a closed permit still reads correctly even
  /// if the person is later renamed or removed from the register.
  nameAtAssignment String
  addedBy          String
  addedAt          DateTime @default(now())

  /// Confined space entry tracking. Null until they go in, cleared when they come out.
  enteredAt DateTime?
  exitedAt  DateTime?

  /// Signed the toolbox talk. A permit cannot go active until everyone named has, which
  /// is the difference between a briefing that happened and one that was minuted.
  toolboxAckAt DateTime?

  @@index([permitId])
  @@index([employeeId])
  @@index([contractorWorkerId])
}

/// One line of a job safety analysis.
///
/// Rows rather than a prose field, because a JSA is only useful if each hazard has a
/// named control and a named person: free text produces "usual precautions apply", which
/// is what an investigation finds when nobody can say who was responsible for what.
///
/// Versioned at the permit level — editing any row bumps the permit version and writes a
/// timeline entry, so a JSA cannot be quietly rewritten after an incident.
model PermitJsaStep {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  /// Display order. The sequence of the job, not a priority.
  sequence Int    @default(0)

  step        String @default("")
  hazard      String
  risk        String @default("")
  control     String
  responsible String @default("")
  /// Risk remaining once the control is in place. The number an approver actually judges.
  residualRisk String @default("")

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([permitId])
}

/// A document attached to a permit.
///
/// Same storage contract as incident evidence: the file is written to UPLOAD_DIR under a
/// server-generated name, and the original filename is kept for display only so it can
/// never be used as a path.
model PermitAttachment {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  /// What the document is, so a permit pack can be assembled and checked for gaps.
  kind PermitAttachmentKind @default(other)

  originalName String
  storedName   String @unique
  mimeType     String
  sizeBytes    Int
  uploadedBy   String
  uploadedById String?

  createdAt DateTime @default(now())

  @@index([permitId])
}

enum PermitAttachmentKind {
  method_statement
  jsa
  gas_test_sheet
  isolation_certificate
  photo
  other
}

/// A calibration certificate for a measuring instrument.
///
/// Kept as history rather than columns on the asset, because "when was this gas detector
/// last calibrated, by whom, against which certificate" is the question an auditor asks
/// and a coroner asks. The current certificate is the most recently issued one, derived
/// on read so a recalibration supersedes automatically.
model Calibration {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  calibratedAt      DateTime
  /// Certificate reference from the calibration house. Quoted externally.
  certificateNumber String
  vendor            String   @default("")
  /// When it lapses. An instrument past this reads numbers nobody should trust.
  expiresAt         DateTime

  result   CalibrationResult @default(pass)
  remarks  String?

  /// The scanned certificate, same storage contract as permit documents.
  documentName String?
  storedName   String?

  recordedBy String
  createdAt  DateTime @default(now())

  @@index([assetId, calibratedAt])
  @@index([expiresAt])
}

enum CalibrationResult {
  pass
  pass_with_adjustment
  fail
}

/// Equipment booked onto a permit.
///
/// This is the join that makes the permit gate possible. A permit that names a gas
/// detector is claiming that instrument will be used on the job, so the permit cannot go
/// active unless the instrument is fit: in service, inspection current, and — for a
/// measuring instrument — calibration valid.
model PermitEquipment {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  assetId  String
  /// Restrict: equipment named on a permit is part of that permit's record.
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict)

  /// What it is there for, in the issuer's words.
  purpose String @default("")

  addedBy String
  addedAt DateTime @default(now())

  @@unique([permitId, assetId])
  @@index([permitId])
  @@index([assetId])
}

/// A permit extension.
///
/// Kept as history rather than overwriting validTo, because "how long was this job
/// actually authorised for, and who kept extending it" is the question asked when the
/// job overruns into a shift nobody planned for.
model PermitExtension {
  id       String @id @default(cuid())
  permitId String
  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)

  previousValidTo DateTime
  newValidTo      DateTime
  reason          String

  requestedBy String
  requestedAt DateTime  @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  rejectedReason String?

  @@index([permitId])
}

// ─── Contractors ─────────────────────────────────────────────────────────────

enum ContractorStatus {
  active
  suspended
}

/// A contracting firm working on the tenant's sites.
///
/// Separate from Company, which is the tenant itself: a contractor has no login, no
/// workspace and no data of its own here. What it has is an insurance certificate that
/// expires, and that expiry is the reason this table exists — an uninsured contractor on
/// site is the tenant's liability, not the contractor's.
model ContractorCompany {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// CON-#### per tenant. Quoted on permits and gate passes.
  code String

  name               String
  /// Companies Commission registration (SSM in Malaysia). Blank until supplied.
  registrationNumber String @default("")
  contactPerson      String @default("")
  phone              String @default("")
  email              String?
  address            String @default("")

  /// Public liability / workmen's compensation expiry. The date that stops them working.
  insuranceExpiry DateTime?

  status ContractorStatus @default(active)

  workers ContractorWorker[]
  permits Permit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, insuranceExpiry])
}

/// An individual working for a contractor on one of the tenant's sites.
///
/// Deliberately not an Employee: they are not on the payroll, their competencies are
/// evidenced by the contractor rather than issued here, and they come and go. What they
/// share with an employee is that an expired medical or induction bars them from site.
model ContractorWorker {
  id                  String            @id @default(cuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractorCompanyId String
  contractorCompany   ContractorCompany @relation(fields: [contractorCompanyId], references: [id], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// CW-#### per tenant.
  workerNo String

  name String
  /// National ID or passport. The only identifier a contractor worker reliably carries,
  /// and what a gate check is done against.
  icPassport String @default("")
  position   String @default("")

  /// Fitness to work, same bar as an employee's.
  medicalExpiry DateTime?
  /// Site induction. Lapses far more often than a medical because it is annual and
  /// nobody schedules it.
  inductionExpiry DateTime?

  emergencyName     String  @default("")
  emergencyPhone    String  @default("")
  emergencyRelation String  @default("")

  /// Gate state. Set by check-in and cleared by check-out, so "who is on site right now"
  /// is a query rather than a paper book in a cabin.
  onSite       Boolean   @default(false)
  checkedInAt  DateTime?

  active Boolean @default(true)

  certificates ContractorCertificate[]
  permitAttendances PermitAttendee[]
  assignedAssets    Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, workerNo])
  @@index([companyId])
  @@index([contractorCompanyId])
  @@index([companyId, medicalExpiry])
  @@index([companyId, inductionExpiry])
  @@index([companyId, onSite])
}

/// Competency evidence supplied by the contractor.
///
/// Not a Certificate: that model is proof this tenant trained someone and carries a
/// verifiable number. This is a scan of somebody else's paperwork, trusted only as far
/// as the expiry date written on it.
model ContractorCertificate {
  id       String           @id @default(cuid())
  workerId String
  worker   ContractorWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  name       String
  issuedBy   String    @default("")
  issueDate  DateTime?
  expiryDate DateTime?
  reference  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
}

/// A tenant-authored course. The standard catalogue lives in trainingCatalog.ts and is
/// available to everyone, same arrangement as the audit templates.
model TrainingCourse {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code        String
  name        String
  category    CourseCategory @default(custom)
  description String         @default("")

  mandatory Boolean @default(false)
  /// Null means a one-time competency that never expires.
  validityMonths Int?
  durationHours  Float   @default(1)
  deliveryModes  DeliveryMode[] @default([])
  competency     String  @default("")
  passMark       Int     @default(80)
  /// Department keywords the course applies to. Empty means the whole workforce.
  applies        String[] @default([])

  createdBy String
  createdAt DateTime @default(now())

  @@unique([companyId, code])
  @@index([companyId])
}

model TrainingSession {
  id String @id @default(cuid())
  /// Human reference (SES-###). Per tenant.
  code String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  /// Either a catalogue id or a TrainingCourse row id — the service resolves both, so
  /// this is not a foreign key.
  courseId   String
  courseName String

  trainer         String
  venue           String       @default("")
  mode            DeliveryMode @default(physical)
  scheduledFor    DateTime
  durationHours   Float        @default(1)
  maxParticipants Int          @default(20)

  status      SessionStatus @default(scheduled)
  signature   String?
  completedAt DateTime?
  completedBy String?

  enrolments   SessionEnrolment[]
  certificates Certificate[]

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([scheduledFor])
}

/// One row per seat. Carries the enrolment before the session and the attendance
/// afterwards, so a seat booked and a seat sat are the same record.
model SessionEnrolment {
  id         String          @id @default(cuid())
  sessionId  String
  session    TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  present Boolean           @default(false)
  result  AttendanceResult?
  score   Int?

  createdAt DateTime @default(now())

  // One seat per person per session — enrolling twice is a mistake, not two seats.
  @@unique([sessionId, employeeId])
  @@index([employeeId])
}

/// Proof of competency, with an expiry taken from the course validity at issue.
/// A renewal is a new row; the current certificate for an employee and course is the
/// most recently issued one, derived on read so a renewal supersedes automatically.
model Certificate {
  id String @id @default(cuid())
  /// CERT-YYYY-####. Unique across the deployment because it is quoted externally and
  /// verified by anyone holding the number.
  number String @unique
  /// Payload behind the printed QR code.
  qrKey  String @unique

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  courseId   String
  courseName String

  sessionId String?
  session   TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  issueDate  DateTime
  /// Null for a competency with no expiry.
  expiryDate DateTime?
  issuedBy   String
  score      Int?
  docName    String?

  createdAt DateTime @default(now())

  @@index([employeeId, courseId, issueDate])
  @@index([companyId])
  @@index([expiryDate])
}

// ─── Administration ──────────────────────────────────────────────────────────
// Governance, security and integrations. User lifecycle, roles and login history are
// NOT modelled again here — they operate on the real User, Membership and LoginAttempt
// tables above. An admin console that manages a parallel copy of the users manages
// nothing, so everything below is the state that genuinely has nowhere else to live.

/// A role's permission matrix, per tenant.
///
/// Note what this is and is not: the matrix is the console's declaration of what a role
/// should be able to do. Service-layer authorisation still switches on Membership.role
/// directly, so editing a cell here does not silently re-open an endpoint. Wiring the
/// two together is a deliberate, separate change.
model RoleDefinition {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Matches Membership.role for the built-in roles; custom roles carry their own slug.
  roleId      String
  name        String
  description String  @default("")
  /// System roles cannot be deleted or reduced below their definition.
  system      Boolean @default(false)
  /// { module: action[] }
  permissions Json

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, roleId])
  @@index([companyId])
}

/// Append-only administrative trail. Never updated or deleted by the application;
/// pruning is the retention policy's job, not a feature of the console.
model AdminAuditEntry {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  actor     String
  actorRole String  @default("")
  action    String
  /// mission_control | incidents | ... | auth | system
  module    String
  target    String  @default("")
  ip        String  @default("")
  device    String  @default("")
  oldValue  String?
  newValue  String?

  at DateTime @default(now())

  @@index([companyId, at])
  @@index([companyId, module])
}

/// An issued API key.
///
/// Only a SHA-256 digest of the secret is stored — the same rule as RefreshToken. The
/// plaintext is returned exactly once, at creation, and cannot be recovered afterwards,
/// so a database leak does not hand an attacker working credentials.
model ApiKey {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String
  /// First characters of the key, shown so a human can tell two keys apart.
  prefix    String
  /// SHA-256 of the full secret. Never the secret itself.
  tokenHash String  @unique
  scopes    String[] @default([])

  lastUsedAt DateTime?
  callsToday Int       @default(0)
  revoked    Boolean   @default(false)
  revokedAt  DateTime?

  createdBy String
  createdAt DateTime @default(now())

  @@index([companyId, revoked])
}

model Webhook {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  url    String
  events String[] @default([])
  active Boolean  @default(true)
  /// SHA-256 of the signing secret, for the same reason as ApiKey.tokenHash.
  secretHash String
  /// Last four characters, so the console can show which secret is configured.
  secretTail String @default("")

  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?
  lastDeliveryCode   Int?

  createdBy String
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// A third-party integration's connection state. Credentials supplied when connecting
/// are stored as a digest, never in cleartext — the console only ever needs to show
/// that a field is set, not what it is.
model ConnectorConfig {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  connectorId String
  connected   Boolean @default(false)
  /// { fieldKey: "set" } — presence only, never the value.
  configSet   Json?

  connectedBy String?
  connectedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([companyId, connectorId])
}

/// Password and session policy. One row per tenant.
model SecurityPolicy {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  passwordMinLength  Int     @default(10)
  requireUppercase   Boolean @default(true)
  requireNumber      Boolean @default(true)
  requireSymbol      Boolean @default(false)
  passwordExpiryDays Int     @default(90)
  lockoutThreshold   Int     @default(5)
  sessionTimeoutHours Int    @default(12)
  mfaRequired        Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model OrgSettings {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  displayName   String @default("")
  legalName     String @default("")
  industry      String @default("")
  timezone      String @default("Asia/Kuching")
  language      String @default("en-MY")
  brandAccent   String @default("#2F6FED")
  logoInitials  String @default("")

  updatedAt DateTime @updatedAt
}

/// Job positions, shift patterns, holidays and business units.
///
/// One table rather than four: they are all small, free-shaped lists the console edits
/// as rows, none is referenced by another model, and four near-identical tables would
/// be four near-identical services.
model OrgConfigItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// position | shift | holiday | unit
  kind String
  data Json

  createdBy String
  createdAt DateTime @default(now())

  @@index([companyId, kind])
}

model RetentionPolicy {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  auditLogDays        Int     @default(365)
  backupCount         Int     @default(10)
  closedIncidentYears Int     @default(7)
  autoBackupDaily     Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// A restore point. The snapshot is the tenant's own data, exported as JSON.
model Backup {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  sizeKb     Int     @default(0)
  by         String
  /// manual | auto | pre_restore
  type       String  @default("manual")
  note       String  @default("")
  restorable Boolean @default(true)
  /// The exported payload. Null once pruned by the retention policy.
  snapshot   Json?

  at DateTime @default(now())

  @@index([companyId, at])
}

// ─── Notifications ───────────────────────────────────────────────────────────

/// A workspace notification.
///
/// Addressed to the workspace rather than to one person, which is what the product
/// already does — an overdue action or a suspended permit is everyone's business. Read
/// state is per user (see NotificationRead), so one person clearing their bell does not
/// clear it for the whole site.
model Notification {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// incident | action | audit | system
  kind   String
  title  String
  detail String  @default("")
  href   String?

  reads NotificationRead[]

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

/// One row per person who has read a notification. Absence means unread, so a new user
/// does not inherit somebody else's cleared bell.
model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

/// Preventive, corrective or emergency work on a piece of equipment.
///
/// Separate from Inspection because the two answer different questions. An inspection asks
/// "is this still fit"; a work order records what was done about it, by whom, for how long
/// the item was down and at what cost. Conflating them loses the downtime figure, which is
/// the number a plant manager is actually judged on.
model WorkOrder {
  id      String @id @default(cuid())
  /// Human reference (WO-####), per tenant.
  code    String
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  kind        MaintenanceKind
  priority    MaintenancePriority @default(medium)
  description String

  assignedTo String @default("")

  /// Planned start. Set at raise time; what "overdue" is measured against.
  dueAt      DateTime?
  startedAt  DateTime?
  finishedAt DateTime?

  /// Minutes the equipment was unavailable. Recorded rather than derived from the
  /// start/finish stamps: a job can be paused overnight without the plant being down.
  downtimeMinutes Int @default(0)

  /// Stored in sen (1/100 of a ringgit) as an integer. Floating point money in a cost
  /// report eventually produces a total that does not match the sum of its rows.
  costSen   Int    @default(0)
  partsUsed String @default("")

  status MaintenanceStatus @default(open)

  raisedBy   String
  raisedAt   DateTime @default(now())
  closedBy   String?
  closingNote String?

  @@unique([assetId, code])
  @@index([assetId, status])
  @@index([status, dueAt])
}

enum MaintenanceKind {
  preventive
  corrective
  emergency
}

enum MaintenancePriority {
  low
  medium
  high
  critical
}

enum MaintenanceStatus {
  open
  in_progress
  completed
  cancelled
}

/// Equipment named on an incident.
///
/// A join table rather than a column on Incident because one incident can involve several
/// items - a sling parted and the load struck a scaffold - and because the same asset
/// accumulating incidents is the signal worth surfacing on its profile.
model IncidentEquipment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  /// What part this equipment played. Free text on purpose: "harness lanyard failed at
  /// the stitching" is worth more than an enum value of "failure".
  involvement String   @default("")
  addedBy     String
  addedAt     DateTime @default(now())

  @@unique([incidentId, assetId])
  @@index([assetId])
}

/// One line of an asset's history.
///
/// Written alongside the row that caused it, in the same transaction, so the timeline
/// cannot drift from the facts. Denormalised on purpose: reconstructing a history by
/// merging five tables at read time is how a timeline ends up missing the one event that
/// mattered, and this is the view an investigator reads after someone is hurt.
model AssetEvent {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  kind   AssetEventKind
  /// One sentence, already written for a human. Rendered as-is.
  summary String
  detail  String?

  actor     String
  actorRole String   @default("")
  at        DateTime @default(now())

  /// Where to go for the full record: a permit id, work order id, incident id. Nullable
  /// because some events - a status change - have nothing further to show.
  refType String?
  refId   String?

  @@index([assetId, at])
}

enum AssetEventKind {
  created
  assigned
  inspection
  calibration
  maintenance
  incident
  status_change
  permit
}


// ─── Visitor management ──────────────────────────────────────────────────────

/// Somebody who is not staff and not a contractor worker, on site for a defined visit.
///
/// The register exists to answer one question at 3am with the alarm sounding: who is
/// inside the fence. Everything else here - approvals, acknowledgements, badges - is
/// machinery that keeps that answer true.
model Visitor {
  id String @id @default(cuid())
  /// Human reference (VIS-####). Per tenant, same reasoning as Incident.number.
  code String

  companyId String
  siteId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  name        String
  /// IC or passport. One column: which one it is varies by nationality and the register
  /// has to match on either when a blacklist is checked.
  idNumber    String
  nationality String @default("")
  visitorCompany String @default("")
  phone       String @default("")
  email       String @default("")
  vehicleNumber String @default("")

  /// The person responsible for them while they are on site. Named from the workforce
  /// register, not typed, so the approval can actually reach somebody.
  hostEmployeeId String?
  hostEmployee   Employee? @relation("VisitorHost", fields: [hostEmployeeId], references: [id], onDelete: SetNull)
  /// Kept as text as well: a host who leaves the company must not erase who signed them in.
  hostNameAtBooking String @default("")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  purpose String @default("")

  expectedArrival   DateTime
  expectedDeparture DateTime
  checkedInAt       DateTime?
  checkedOutAt      DateTime?

  status VisitorStatus @default(draft)

  /// Physical pass handed over at reception. Unique per site while it is out.
  badgeNumber String?
  badgeIssuedAt DateTime?
  badgeReturnedAt DateTime?

  /// Opaque payload printed on the pass. Separate from `code` so a pass can be reissued
  /// without renumbering the visit, and so a stale pass resolves to a clear 404.
  passKey String @unique

  notes String?

  emergencyContactName  String @default("")
  emergencyContactPhone String @default("")

  // Site rules. Each is a timestamp rather than a boolean: "when did they acknowledge the
  // emergency procedure" is the question asked after an evacuation, and a boolean cannot
  // answer it.
  inductionAt        DateTime?
  ndaAt              DateTime?
  safetyBriefingAt   DateTime?
  emergencyProcedureAt DateTime?
  siteRulesAt        DateTime?

  approvedBy   String?
  approvedAt   DateTime?
  rejectedBy   String?
  rejectedAt   DateTime?
  decisionNote String?

  deniedReason String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Optimistic concurrency, same as the other registers.
  version   Int      @default(0)

  events    VisitorEvent[]
  documents VisitorDocument[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, siteId, status])
  @@index([companyId, expectedArrival])
  @@index([hostEmployeeId])
  @@index([idNumber])
}

/// The visit lifecycle.
///
/// Appended in the order a visit actually moves so the enum reads as a process. Postgres
/// enums are append-only, so anything added later goes on the end regardless.
enum VisitorStatus {
  draft
  pre_registered
  waiting
  checked_in
  on_site
  checked_out
  expired
  denied
  blacklisted
  cancelled
}

/// One line of a visit's history. Written alongside the change that caused it.
model VisitorEvent {
  id        String @id @default(cuid())
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  kind    VisitorEventKind
  /// One sentence, already written for a human. Rendered as-is.
  summary String
  detail  String?

  actor     String
  actorRole String   @default("")
  at        DateTime @default(now())

  @@index([visitorId, at])
}

enum VisitorEventKind {
  created
  approved
  rejected
  checked_in
  checked_out
  badge_issued
  badge_returned
  vehicle_added
  vehicle_removed
  blacklisted
  note_added
  acknowledgement
  status_change
}

/// A photo or signed document held against a visit.
///
/// Same storage contract as equipment documents and permit attachments.
model VisitorDocument {
  id        String @id @default(cuid())
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  /// photo | id_scan | nda | other
  kind String @default("photo")

  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  uploadedBy   String
  uploadedById String

  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([visitorId, kind])
}

/// A person, company or vehicle refused entry.
///
/// Matched server-side at pre-registration and again at check-in, because a blacklist
/// checked only by the screen is not a blacklist. Kept as one table with a nullable
/// column per match type rather than a type/value pair, so a row cannot claim to be a
/// phone match and hold an IC number.
model VisitorBlacklist {
  id        String @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  idNumber      String?
  phone         String?
  visitorCompany String?
  vehicleNumber String?

  reason String
  /// Null means permanent. A date means it lapses on its own, which is what stops a
  /// blacklist becoming a list nobody dares prune.
  expiresAt DateTime?

  active    Boolean  @default(true)
  addedBy   String
  addedAt   DateTime @default(now())
  liftedBy  String?
  liftedAt  DateTime?

  @@index([companyId, active])
  @@index([idNumber])
  @@index([phone])
  @@index([vehicleNumber])
}
