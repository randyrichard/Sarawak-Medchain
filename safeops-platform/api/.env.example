# SafeOps API configuration — copy to .env and fill in.
# .env is gitignored. Never commit real secrets.

NODE_ENV=development
PORT=4000

# Postgres (docker compose up -d db provides this locally)
DATABASE_URL=postgresql://safeops:safeops@localhost:5433/safeops?schema=public

# RS256 keypair — generate with: npm run keygen
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=safeops-api
JWT_AUDIENCE=safeops-web

# Short access-token lifetime limits the damage window of a stolen token;
# the refresh token is what provides continuity.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Brute-force policy
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Comma-separated allow-list
CORS_ORIGINS=http://localhost:5181
# COOKIE_DOMAIN=.safeops.app

# ── Email delivery for scheduled reports ─────────────────────────────────────
# All optional. With none of these set the platform runs exactly as before:
# reports are generated and stored, and the run history says "Generated" rather
# than claiming an email nobody received. Configuring a provider turns delivery
# on with no code change and no different build.
#
# Two providers are implemented behind one interface. Resend wins if both are set.
#
# Never commit a real value here — .env is gitignored, .env.example is not.

# Resend, the default provider.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# SMTP, for customers whose mail policy requires their own relay. Any provider or
# an in-house Exchange server works:
#   SES       smtps://AKIA...:BJ...@email-smtp.ap-southeast-1.amazonaws.com:465
#   Postmark  smtps://<token>:<token>@smtp.postmarkapp.com:587
#   Mailtrap  smtp://<user>:<pass>@sandbox.smtp.mailtrap.io:2525
# SMTP_URL=smtp://user:pass@localhost:2525

# The envelope sender. Required whenever a provider is configured; the API refuses
# to boot without it, because a relay rejects every message that has no From.
# REPORT_EMAIL_FROM="SafeOps <safeops@yourcompany.com>"

# Where this deployment is reachable from a browser. Every link that leaves the building -
# invitation, password reset, the button in a scheduled report - is built from this.
# Optional in development, where the first CORS origin stands in. REQUIRED in production,
# and refused at boot if it points at localhost: a link nobody outside the machine can
# reach is worse than no link, because it looks like it worked.
# APP_PUBLIC_URL=https://app.yourcompany.com

# Optional. Where replies go, if not the sender.
# MAIL_REPLY_TO=hse@yourcompany.com

# The business day (IANA zone): when "today" and "this month" roll over. Default Asia/Kuching.
APP_TIMEZONE=Asia/Kuching
