# SafeOps API configuration — copy to .env and fill in.
# .env is gitignored. Never commit real secrets.

NODE_ENV=development
PORT=4000

# Postgres (docker compose up -d db provides this locally)
DATABASE_URL=postgresql://safeops:safeops@localhost:5433/safeops?schema=public

# RS256 keypair — generate with: npm run keygen
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=safeops-api
JWT_AUDIENCE=safeops-web

# Short access-token lifetime limits the damage window of a stolen token;
# the refresh token is what provides continuity.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Brute-force policy
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Comma-separated allow-list
CORS_ORIGINS=http://localhost:5181
# COOKIE_DOMAIN=.safeops.app
