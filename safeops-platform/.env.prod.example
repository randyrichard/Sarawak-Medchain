# SafeOps pilot deployment — copy to .env.prod and fill in.
# .env.prod is gitignored. Never commit real values.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod --profile tls up -d --build
#
# ── Every REPLACE_ME must go ─────────────────────────────────────────────────
# Placeholders below are written as REPLACE_ME.example.com deliberately. They are obvious
# to a human reading the file, and they are also refused by the API at boot: example.com
# is reserved by RFC 2606 and can never belong to a real deployment. So a half-filled
# config fails immediately and loudly rather than running and sending your customer
# invitation links to a domain that does not exist.
#
# Nothing in this file has a working default. That is the point.

# ── Database ─────────────────────────────────────────────────────────────────
# These three configure the PostgreSQL container that ships with the stack. It publishes
# no port and is reachable only by the API over the private compose network.
POSTGRES_USER=safeops
# REQUIRED. Generate a fresh one at deployment time, do not reuse anything:
#   openssl rand -base64 24
# There is no default. The stack refuses to start with this empty.
POSTGRES_PASSWORD=
POSTGRES_DB=safeops

# ── Managed database (optional) ──────────────────────────────────────────────
# Leave DATABASE_URL empty to use the container above — which is the default and is what
# most deployments want.
#
# Set it to point at a managed database instead (DigitalOcean, RDS, Cloud SQL). It replaces
# the connection string wholesale, so POSTGRES_USER/PASSWORD/DB above stop being used for
# the API and the `db` service can be left out of `docker compose up`.
#
# sslmode is REQUIRED for a managed database and the API refuses to start in production
# without it. The connection crosses a real network and so does everything this product
# stores — injury records, medical restrictions, password hashes. `sslmode=require`
# encrypts; `verify-full` also checks the certificate against the provider's CA and is
# better if you have the CA file to hand. `disable` and `allow` are both refused.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@your-db.ondigitalocean.com:25060/safeops?sslmode=require&connection_limit=20&pool_timeout=15
#
# Remember connection_limit: without it Prisma sizes the pool from the host CPU count and
# a managed database's connection cap is usually far lower than a self-hosted one's.
DATABASE_URL=

# ── Signing keys ─────────────────────────────────────────────────────────────
# Generate both with:  npm run keygen
# These sign access tokens. Rotating them signs everyone out, which is the intended
# emergency response to a suspected compromise.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# ── Domain and TLS ───────────────────────────────────────────────────────────
# Used by the `tls` profile in docker-compose.prod.yml, which runs deploy/Caddyfile and
# obtains a real Let's Encrypt certificate automatically.
#
# Both names must already resolve to this server BEFORE you start the stack: Caddy proves
# control of them to get a certificate, so DNS comes first, not after. They must also
# share a registrable domain - the refresh cookie is SameSite=Strict, and a pair on
# different registrable domains will silently fail to keep anyone signed in.
#
# Skip these three only if something else terminates TLS (a cloud load balancer, or the
# nginx config in deploy/nginx-safeops.conf) and you start without `--profile tls`.
SAFEOPS_APP_DOMAIN=REPLACE_ME.example.com
SAFEOPS_API_DOMAIN=api.REPLACE_ME.example.com
# Where Let's Encrypt sends certificate-expiry warnings. A real mailbox somebody reads.
ACME_EMAIL=REPLACE_ME@example.com

# ── Origins ──────────────────────────────────────────────────────────────────
# Where the browser loads the app from. The API rejects requests from anywhere else.
CORS_ORIGINS=https://REPLACE_ME.example.com

# What the browser calls. Baked into the bundle at build time — changing it needs a
# rebuild, not a restart.
VITE_API_BASE_URL=https://api.REPLACE_ME.example.com

# The refresh cookie is sameSite=strict. That is correct when the web app and the API
# share a registrable domain (app.yourcompany.com and api.yourcompany.com do).
# If they do not, the browser will not send the cookie and no session will survive a
# reload — put them on one domain rather than weakening the cookie.
COOKIE_DOMAIN=.REPLACE_ME.example.com

# ── Public address ───────────────────────────────────────────────────────────
# Where this deployment is reachable from a browser. Every link that leaves the building
# is built from it: the invitation somebody clicks to create their account, the button in
# a scheduled report.
#
# REQUIRED in production and validated at boot. The API refuses to start without it, and
# refuses a localhost or 127.0.0.1 value - a link nobody outside the machine can reach is
# worse than no link, because to the person who sent it it looks like it worked.
#
# MUST be https. The API refuses to boot on a plaintext value, because every link built
# from it carries a single-use credential in the URL - the invitation that creates an
# account and the reset link that takes one over.
APP_PUBLIC_URL=https://REPLACE_ME.example.com

# ── Email ────────────────────────────────────────────────────────────────────
# Optional to start, but strongly recommended before a real customer.
#
# With none of this set the product still works and nothing is ever reported as emailed
# when it was not: reports generate and are downloadable, and invitations and password
# resets show the administrator a link to pass on by hand. What you lose is self-service —
# a user who forgets their password cannot recover it without a human, and a customer's
# sole administrator has to contact you.
#
# What it turns on, once configured:
#   - invitation emails when a user is added or a customer is provisioned
#   - password-reset emails, including the self-service "Forgot password?" flow
#   - scheduled report delivery
#
# Set REPORT_EMAIL_FROM plus exactly one transport.
#
# The envelope sender. REQUIRED as soon as either transport below is set - the API refuses
# to boot with a transport and no sender, because a relay rejects every message without a
# From and the run history would fill with failures caused by a missing line here.
# REPORT_EMAIL_FROM="SafeOps <safeops@yourcompany.com>"

# Transport 1 - Resend. Server-side only; it is never sent to the browser and never
# written to the audit trail. Create the key in the Resend dashboard and verify the
# sending domain there first, or every message is refused.
# RESEND_API_KEY=

# Transport 2 - SMTP, for a customer whose mail policy requires their own relay. Use one
# or the other; Resend wins if both are set.
# SMTP_URL=smtps://user:password@smtp.yourcompany.com:465

# Where replies go, if that is not the sender.
# MAIL_REPLY_TO=hse@yourcompany.com

# ── Sessions ─────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ── Scheduler ────────────────────────────────────────────────────────────────
# Reminder and escalation sweeps run inside the API. If you ever run more than one API
# instance, set SCHEDULER_ENABLED=false on all but one.
SCHEDULER_INTERVAL_MIN=15

# ── Capacity ─────────────────────────────────────────────────────────────────
# Prisma's connection pool. Left unset it is sized from the host's CPU count, so the same
# image opens 17 connections on an 8-core box and 65 on a 32-core one. Keep the total
# across all API instances below the database's max_connections (100), leaving headroom
# for pg_dump and a psql session during an incident.
DB_POOL_SIZE=20

# Requests per minute per client IP. A customer behind corporate NAT is a single IP, so
# this is a budget for a whole site rather than one person: the dashboard alone issues
# nine requests. It exists to stop one runaway client exhausting the pool, not to pace
# normal use. Health checks are exempt.
RATE_LIMIT_PER_MIN=3000

# ── Reverse proxies in front of the API ──────────────────────────────────────
# WHICH peers are allowed to say where a request came from, via X-Forwarded-For.
#
# This is not cosmetic. req.ip is the key the rate limiter buckets on and the address written
# into the audit trail and login history. Anyone who can choose it can hand themselves an
# unlimited supply of fresh rate-limit budgets, and can put an address of their choosing in
# the security log.
#
# This setting used to be a hop count, and a count cannot express the rule: it says how many
# forwarded entries to believe, never who was entitled to add them. Any non-zero value made
# the process treat whoever opened the socket as a proxy, so a client could simply name
# itself. If TRUST_PROXY_HOPS is still present anywhere, the API now refuses to boot rather
# than silently reverting to that.
#
# The default is right for the bundled stack: Caddy reaches the API over the private compose
# network, so private and loopback peers are believed and nothing on a public address is.
# A CDN does not change it - Cloudflare talks to Caddy, and Caddy is still the peer this
# process sees. See docs/CLOUDFLARE.md.
#
#   loopback,linklocal,uniquelocal   the bundled stack                        (default)
#   false                            nothing in front; trust no header
#   10.0.0.5,192.168.1.0/24          only these peers, for a load balancer at a known address
TRUST_PROXY=loopback,linklocal,uniquelocal

# Proves to the API that a request came through the reverse proxy.
#
# REQUIRED in production whenever TRUST_PROXY is not `false` - the API refuses to boot
# otherwise - because behind Docker an address cannot establish it. Published ports are
# source-NATed to the bridge gateway, which is a private address the trust list accepts, so
# a caller reaching the API directly is indistinguishable from Caddy. Measured: forged
# X-Forwarded-For headers still produced separate rate-limit buckets on a direct connection
# after the trust list was introduced.
#
# Caddy sends it as X-SafeOps-Proxy; the API strips X-Forwarded-For from anything that
# cannot present it. Same value in both places, which compose handles from this one line.
#
#   openssl rand -hex 32
PROXY_TOKEN=

# ── Backups ──────────────────────────────────────────────────────────────────
# Where deploy/backup.sh writes. Must be on a volume you copy off this host — a backup on
# the machine it protects is not a backup.
BACKUP_DIR=/backups
BACKUP_KEEP_DAYS=30

# ── Published ports ──────────────────────────────────────────────────────────
# Both sit behind whatever terminates TLS, and both are bound to 127.0.0.1 by default.
#
# That default matters on a public server: published on 0.0.0.0 these are plaintext HTTP
# ports on the public interface, and anything reaching them bypasses TLS and HSTS
# completely. Caddy reaches both over the compose network rather than through a published
# port, so loopback costs nothing.
#
# Change BIND_HOST only if the thing terminating TLS runs on a different machine - and
# then restrict it at the firewall.
BIND_HOST=127.0.0.1
WEB_PORT=8080
API_PORT=4000
