# SafeOps pilot deployment — copy to .env.prod and fill in.
# .env.prod is gitignored. Never commit real values.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=safeops
POSTGRES_PASSWORD=            # generate: openssl rand -base64 24
POSTGRES_DB=safeops

# ── Signing keys ─────────────────────────────────────────────────────────────
# Generate both with:  npm run keygen
# These sign access tokens. Rotating them signs everyone out, which is the intended
# emergency response to a suspected compromise.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# ── Origins ──────────────────────────────────────────────────────────────────
# Where the browser loads the app from. The API rejects requests from anywhere else.
CORS_ORIGINS=https://safeops.example.com

# What the browser calls. Baked into the bundle at build time — changing it needs a
# rebuild, not a restart.
VITE_API_BASE_URL=https://api.safeops.example.com

# The refresh cookie is sameSite=strict. That is correct when the web app and the API
# share a registrable domain (safeops.example.com and api.safeops.example.com do).
# If they do not, the browser will not send the cookie and no session will survive a
# reload — put them on one domain rather than weakening the cookie.
COOKIE_DOMAIN=.safeops.example.com

# ── Sessions ─────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ── Scheduler ────────────────────────────────────────────────────────────────
# Reminder and escalation sweeps run inside the API. If you ever run more than one API
# instance, set SCHEDULER_ENABLED=false on all but one.
SCHEDULER_INTERVAL_MIN=15

# ── Published ports ──────────────────────────────────────────────────────────
# Both sit behind whatever terminates TLS.
WEB_PORT=8080
API_PORT=4000
